<view class="page">
  <view class="seg">
    <text class="sg {{tab === 'log' ? 'on' : ''}}" data-tab="log" bindtap="switchTab">记录</text>
    <text class="sg {{tab === 'stats' ? 'on' : ''}}" data-tab="stats" bindtap="switchTab">统计</text>
  </view>

  <!-- 快记 -->
  <block wx:if="{{tab === 'log'}}">
    <view class="quick">
      <view class="qrow">
        <textarea
          class="qarea"
          placeholder="今天怎么样？训练感受、体重、睡眠、状态都能记"
          value="{{quickText}}"
          bindinput="onQuickInput"
          maxlength="600"
          auto-height
          show-confirm-bar="{{false}}"
        />
        <text class="qcam" bindtap="goCam" aria-label="拍一张记饮食">📷</text>
      </view>
      <view class="hintrow" wx:if="{{infer && !todayCount}}">
        <text class="infer" bindtap="applyInfer">识别为 {{infer.key === 'work' ? '工作' : infer.key === 'fit' ? '健身' : '生活习惯'}}{{infer.tags.length ? ' · ' + infer.tags.join(' / ') : ''}} · 采用</text>
      </view>
      <view class="hintrow" wx:if="{{parseHint}}">
        <text class="infer fit" bindtap="convertTrain">这句像训练：{{parseHint.name}} {{parseHint.sets}}×{{parseHint.reps}}{{parseHint.weight ? ' ' + parseHint.weight + 'kg' : ''}} · 转成训练 ›</text>
      </view>

      <view class="trow">
        <text class="tl">类型</text>
        <scroll-view class="tchips" scroll-x="true" enhanced="true" show-scrollbar="false">
          <text class="chip {{typeKey === item.key ? 'on' : ''}}" wx:for="{{types}}" wx:key="key" data-k="{{item.key}}" bindtap="pickType">{{typeKey === item.key ? '✓ ' : ''}}{{item.label}}</text>
        </scroll-view>
      </view>

      <view class="trow">
        <text class="tl">标签</text>
        <scroll-view class="tchips" scroll-x="true" enhanced="true" show-scrollbar="false">
          <text class="chip sm {{pickedTags.indexOf(item) >= 0 ? 'on' : ''}}" wx:for="{{typeTags}}" wx:key="*this" data-tag="{{item}}" bindtap="toggleTag">{{pickedTags.indexOf(item) >= 0 ? '✓ ' : ''}}{{item}}</text>
          <text class="chip sm none" bindtap="goSetting">{{typeTags.length ? '＋ 管理' : '去设置里加标签'}}</text>
        </scroll-view>
      </view>

      <view class="score-row {{quickEnergy ? '' : 'idle'}}">
        <view class="score-top">
          <text class="score-l">精力{{quickEnergy ? ' · ' + energyLabels[quickEnergy - 1] : ''}}</text>
          <view class="score-vw">
            <text class="score-num {{quickEnergy ? 'on' : ''}}">{{quickEnergy || '—'}}</text>
            <text class="score-u">/5</text>
            <text class="score-w {{quickEnergy ? 'on' : ''}}">{{quickEnergy ? energyLabels[quickEnergy - 1] : '点一档'}}</text>
          </view>
        </view>
        <view class="score-lab">
          <view class="sl-i {{quickEnergy === index + 1 ? 'on' : ''}}" wx:for="{{energyLabels}}" wx:key="*this" data-k="quickEnergy" data-v="{{index + 1}}" bindtap="pickScore">{{quickEnergy === index + 1 ? '✓ ' : ''}}{{item}}</view>
        </view>
      </view>
      <view class="score-row {{quickMood ? '' : 'idle'}}">
        <view class="score-top">
          <text class="score-l">情绪{{quickMood ? ' · ' + moodLabels[quickMood - 1] : ''}}</text>
          <view class="score-vw">
            <text class="score-num m {{quickMood ? 'on' : ''}}">{{quickMood || '—'}}</text>
            <text class="score-u">/5</text>
            <text class="score-w m {{quickMood ? 'on' : ''}}">{{quickMood ? moodLabels[quickMood - 1] : '点一档'}}</text>
          </view>
        </view>
        <view class="score-lab">
          <view class="sl-i m {{quickMood === index + 1 ? 'on' : ''}}" wx:for="{{moodLabels}}" wx:key="*this" data-k="quickMood" data-v="{{index + 1}}" bindtap="pickScore">{{quickMood === index + 1 ? '✓ ' : ''}}{{item}}</view>
        </view>
      </view>

      <view class="qfoot">
        <view class="qleft">
          <text class="yt {{yesterday ? 'on' : ''}}" bindtap="toggleYesterday">{{yesterday ? '✓ ' : ''}}记到昨天</text>
          <text class="demo" bindtap="loadDemo">载入示例</text>
        </view>
        <view class="qright">
          <text class="qs {{saveOn ? 'on' : 'off'}}" bindtap="saveQuick">保存</text>
        </view>
      </view>
    </view>

    <!-- 时间线 -->
    <view class="tl-grp" wx:for="{{groups}}" wx:key="date" wx:for-item="grp">
      <view class="dl">
        <text class="dname">{{grp.label}}</text>
        <text class="dnum">{{grp.logs.length}} 条</text>
      </view>

      <view class="tcard" wx:for="{{grp.logs}}" wx:for-item="lg" wx:key="id">
        <view class="ch">
          <text class="ltype {{lg.isTrain ? 'fit' : ''}}" style="{{lg.isTrain ? '' : 'color:' + lg.typeColor + ';border-color:' + lg.typeColor}}">{{lg.isTrain ? '训练' : (lg.typeLabel || '记录')}}</text>
          <text class="ctime">{{lg.timeText}}</text>
          <text class="cmore" wx:if="{{!lg.isTrain}}" data-id="{{lg.id}}" catchtap="openLogMenu">⋯</text>
        </view>

        <block wx:if="{{lg.isTrain}}">
          <text class="csum">{{lg.summary}}</text>
          <view class="ex {{row.open ? 'open' : ''}}" wx:for="{{lg.rows}}" wx:for-item="row" wx:key="key">
            <view class="eh" data-id="{{lg.id}}" data-key="{{row.key}}" bindtap="toggleRow">
              <text class="en">{{row.name}}</text>
              <text class="cbadge" wx:if="{{row.isCardio}}">有氧</text>
              <text class="el">{{row.line}}</text>
              <text class="more" data-uid="{{row.uid}}" data-cardio="{{row.isCardio}}" data-date="{{grp.date}}" catchtap="editRow">⋯</text>
            </view>
            <view class="sets" wx:if="{{row.open}}">
              <view class="set" wx:for="{{row.groups}}" wx:for-item="g" wx:key="no">
                <text class="no">{{g.no}}</text>
                <text class="st {{g.done ? 'on' : ''}}">{{g.txt}}</text>
                <text class="gsec">{{g.sec}}</text>
                <text class="mk">{{g.done ? '✓' : '待'}}</text>
              </view>
              <view class="set" wx:if="{{row.isCardio && row.cdMode !== 'sets'}}">
                <text class="no">1</text>
                <text class="st {{row.done ? 'on' : ''}}">有氧 · 时长训练</text>
                <text class="mk">{{row.done ? '✓' : '待'}}</text>
              </view>
            </view>
          </view>
        </block>

        <block wx:elif="{{lg.isMeal}}">
          <view class="mcard-h">
            <text class="mh-l">{{lg.meal || '一餐'}}</text>
            <text class="mh-k">约 {{lg.kcal}}</text>
            <text class="mh-u">kcal</text>
          </view>
          <view class="mitem" wx:for="{{lg.items}}" wx:for-item="mi" wx:for-index="mii" wx:key="name" data-id="{{lg.id}}" data-i="{{mii}}" bindtap="fixMeal">
            <text class="mn {{mi.low ? 'low' : ''}}">{{mi.name}}</text>
            <text class="mlow" wx:if="{{mi.low}}">待确认</text>
            <text class="mp">{{mi.portion}}</text>
            <text class="mk2">{{mi.kcal}}<text class="mku"> kcal</text></text>
          </view>
          <text class="mhint" wx:if="{{lg.items.length}}">点任一项改份量</text>
          <image class="mpic" wx:if="{{lg.pic}}" src="{{lg.pic}}" mode="aspectFill" />
        </block>

        <block wx:else>
          <text class="ctext">{{lg.text}}</text>
          <view class="score-tags" wx:if="{{lg.score || lg.mood}}">
            <text class="stag" wx:if="{{lg.score}}">精力 {{lg.score}}</text>
            <text class="stag" wx:if="{{lg.mood}}">情绪 {{lg.moodText || lg.mood}}</text>
          </view>
          <text class="ctag" wx:if="{{lg.tags}}">{{lg.tags}}</text>
        </block>
      </view>
    </view>

    <view class="empty" wx:if="{{!groups.length}}">
      <text class="et">还没有记录</text>
      <text class="es">先在上面写一句，或者去「训练」记动作</text>
    </view>
  </block>

  <!-- 统计 -->
  <block wx:else>
    <view class="ranges">
      <text class="rg {{range === 7 ? 'on' : ''}}" data-r="7" bindtap="setRange">7 天</text>
      <text class="rg {{range === 30 ? 'on' : ''}}" data-r="30" bindtap="setRange">30 天</text>
      <text class="rg {{range === 90 ? 'on' : ''}}" data-r="90" bindtap="setRange">90 天</text>
      <text class="rg {{range === 'custom' ? 'on' : ''}}" data-r="custom" bindtap="setRange">自定义</text>
      <text class="rg-date" wx:if="{{stats}}">{{stats.start}} ~ {{stats.end}}</text>
    </view>
    <view class="cpick" wx:if="{{range === 'custom'}}">
      <picker mode="date" value="{{cStart}}" end="{{cEnd || stats.end}}" bindchange="onCStart">
        <text class="cpv">{{cStart || '开始日期'}}</text>
      </picker>
      <text class="cpd">至</text>
      <picker mode="date" value="{{cEnd}}" start="{{cStart}}" end="{{stats.end}}" bindchange="onCEnd">
        <text class="cpv">{{cEnd || '结束日期'}}</text>
      </picker>
    </view>

    <block wx:if="{{stats}}">
      <view class="kgrid">
        <view class="k" wx:for="{{stats.kpis}}" wx:key="l">
          <text class="kl">{{item.l}}</text>
          <view class="kv"><text class="kn">{{item.v}}</text><text class="ku">{{item.u}}</text></view>
          <text class="kd {{item.d.cls}}">{{item.d.txt}}</text>
        </view>
      </view>

      <view class="empty" wx:if="{{stats.empty}}">
        <text class="et">这段还没有数据</text>
        <text class="es">记几笔就能看到趋势</text>
        <view class="cta" bindtap="switchTab" data-tab="log">去记一笔</view>
      </view>

      <block wx:else>
        <!-- 记录页只留 KPI 与快记；趋势图统一在分析页 -->
        <view class="stat-link" bindtap="goAgent">
          <view class="sl-l">
            <text class="sl-t">趋势与图表</text>
            <text class="sl-s">精力情绪 · 容量有氧 · 部位均衡 · PR 曲线</text>
          </view>
          <text class="sl-a">去分析页 ›</text>
        </view>
      </block>
    </block>
  </block>
</view>

<train-editor
  visible="{{editorVisible}}"
  payload="{{payload}}"
  bind:close="onEditorClose"
  bind:confirm="onEditorConfirm"
  bind:delete="onEditorDelete"
/>

<float-orb id="orb" bottom="40" dim="{{scrollDim}}" bind:focus="orbFocus" bind:summary="orbSummary" bind:noted="afterOrbNote" />
