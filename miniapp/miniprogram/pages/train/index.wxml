<view class="page">
  <view class="head">
    <view class="datebar">
      <text class="dlabel" bindtap="scrollTop">{{barDate}}</text>
      <text class="prmini {{prToday ? 'has' : ''}}" bindtap="goPr">{{prTxt}}</text>
      <view class="db-r">
        <text class="libbtn" bindtap="openPlan">📅</text>
        <text class="seg-add" bindtap="openAddSheet">＋</text>
      </view>
    </view>

    <text class="sum">{{summary}}</text>
    <kpi-strip items="{{kpis}}" />

    <view class="focusbar" wx:if="{{!empty}}" catchtap="orbFocus">
      <view class="fb-ic">▶</view>
      <view class="fb-l">
        <text class="fb-t">{{fbDone ? '今天的组都完成了' : '专注训练'}}</text>
        <text class="fb-s">{{fbDone ? '点开看小结、加练或收工' : '一场做完今天的 ' + list.length + ' 个动作，逐组记录'}}</text>
      </view>
      <text class="fb-go">{{fbDone ? '看小结 ›' : '开始 ›'}}</text>
    </view>
  </view>

  <!-- ================= 今天（单流第一段） ================= -->
    <!-- 组间休息 pill -->
    <view class="restpill" wx:if="{{rest.show}}">
      <text class="rp-t">休息 {{rest.left}}″</text>
      <text class="rp-l">{{rest.label}}</text>
      <text class="rp-x" bindtap="skipRest">跳过</text>
    </view>

    <scroll-view class="favstrip" wx:if="{{!empty && favStrip.length}}" scroll-x="true" enhanced="true" show-scrollbar="false">
      <text class="fs-l">★ 收藏</text>
      <view class="fs-chip" wx:for="{{favStrip}}" wx:key="id" data-id="{{item.id}}" data-name="{{item.n}}" data-part="{{item.p}}" bindtap="addFav">
        <text class="fsc-n">{{item.n}}</text>
        <text class="fsc-a">＋</text>
      </view>
    </scroll-view>

    <view class="modes" wx:if="{{!empty}}">
      <text class="mode {{!grid ? 'on' : ''}}" bindtap="toggleGrid">列表</text>
      <text class="mode {{grid ? 'on' : ''}}" bindtap="toggleGrid">图卡</text>
      <text class="mode ghost" bindtap="showSummary">训练小结</text>
    </view>

    <!-- 图卡网格 -->
    <view class="grid" wx:if="{{grid && !empty}}">
      <view class="gcard" wx:for="{{list}}" wx:key="uid">
        <text class="cbadge gcb" wx:if="{{item.isCardio}}">有氧</text>
        <view class="gc-ph {{item.isCardio ? 'cd' : ''}}" data-uid="{{item.uid}}" catchtap="openDetail">
          <text class="gc-phn">{{item.isCardio ? item.name : (item.part || '动作')}}</text>
          <image wx:if="{{item.img}}" class="gc-img" src="{{item.img}}" mode="aspectFill" data-uid="{{item.uid}}" bindload="gridImgOk" binderror="gridImgErr" />
        </view>
        <text class="gc-n">{{item.name}}</text>
        <text class="gc-v">{{item.isCardio && item.cdMode !== 'sets' ? (item.done ? '✓' : '—') : item.doneN + '/' + item.totalN}}</text>
        <text class="gc-s">{{item.line}}</text>
        <view class="gc-bar"><view class="gc-in" style="width: {{item.totalN ? (item.doneN / item.totalN * 100) : 0}}%"></view></view>
        <view class="gc-act">
          <text data-uid="{{item.uid}}" data-cardio="{{item.isCardio}}" catchtap="openEdit">编辑</text>
        </view>
      </view>
    </view>

    <view class="card" wx:if="{{!empty && !grid}}">
      <view class="ex {{item.open ? 'open' : 'closed'}} {{dragUid === item.uid ? 'dragging' : ''}} {{item.dy && dragUid !== item.uid ? 'shift' : ''}}" style="{{item.dy ? 'transform: translateY(' + item.dy + 'px);' : ''}}" wx:for="{{list}}" wx:key="uid">
        <view class="ex-head" data-uid="{{item.uid}}" bindtap="toggleRow">
          <view class="grip" data-uid="{{item.uid}}" bindlongpress="dragStart" catchtouchmove="dragMove" bindtouchend="dragEnd">≡</view>
          <view class="ex-main">
            <view class="nm-row">
              <text class="nm">{{item.name}}<text class="fav" wx:if="{{item.fav}}"> ★</text></text>
              <text class="cbadge" wx:if="{{item.isCardio}}">有氧</text>
              <text class="line one" wx:if="{{!item.open}}">{{item.line}}</text>
            </view>
            <text class="line" wx:if="{{item.open}}">{{item.line}}</text>
          </view>
          <view class="dots" wx:if="{{!item.isCardio || item.cdMode === 'sets'}}">
            <text class="dot {{idx < item.doneN ? 'on' : ''}}" wx:for="{{item.groups}}" wx:for-item="g" wx:for-index="idx" wx:key="no"></text>
          </view>
          <text class="cdmark" wx:if="{{item.isCardio && item.cdMode !== 'sets'}}">{{item.cdMin}}′</text>
          <text class="more" data-uid="{{item.uid}}" catchtap="openRowMenu">⋯</text>
          <text class="ar">▸</text>
        </view>

        <view class="sets" wx:if="{{item.open && !item.isCardio}}">
          <text class="sug" wx:if="{{item.sugLine}}">{{item.sugLine}}</text>
          <view class="set" wx:for="{{item.groups}}" wx:for-item="g" wx:for-index="gi" wx:key="no">
            <text class="no {{g.warmup ? 'warm' : ''}}" data-uid="{{item.uid}}" data-i="{{gi}}" catchtap="tapGroup">{{g.no}}</text>
            <view class="mid" data-uid="{{item.uid}}" data-i="{{gi}}" bindtap="tapGroup">
              <text class="txt {{g.done ? 'done' : ''}}">{{g.txt}}</text>
              <text class="gsec">{{g.sec}}</text>
              <text class="gtag" wx:if="{{g.tag === 'drop'}}">递减</text>
              <text class="gtag side" wx:if="{{g.tag === 'side'}}">单侧</text>
              <text class="gtag super" wx:if="{{g.tag === 'super'}}">超级组</text>
              <text class="gtag rpe" wx:if="{{g.rpe}}">RPE {{g.rpe}}</text>
            </view>
            <text class="mark {{g.done ? 'on' : ''}}">{{g.done ? '✓' : '待'}}</text>
            <text class="gmore" data-uid="{{item.uid}}" data-i="{{gi}}" catchtap="openSetMenu">⋯</text>
          </view>
          <text class="hint">长按 ≡ 可拖动排序（有氧一起排）；点组打卡；组行 ⋯ 可暖身/递减/单侧/超级组；动作 ⋯ 可看详情</text>
          <view class="focusbtn" data-uid="{{item.uid}}" catchtap="focus">进入专注模式 ›</view>
        </view>

        <view class="sets" wx:if="{{item.open && item.isCardio}}">
          <view class="set" wx:if="{{item.cdMode === 'sets'}}" wx:for="{{item.groups}}" wx:for-item="g" wx:for-index="gi" wx:key="no">
            <text class="no cdn" data-uid="{{item.uid}}" data-i="{{gi}}" catchtap="tapCardioGroup">{{g.no}}</text>
            <view class="mid" data-uid="{{item.uid}}" data-i="{{gi}}" bindtap="tapCardioGroup">
              <text class="txt {{g.done ? 'done' : ''}}">{{g.txt}}</text>
              <text class="gtag rpe" wx:if="{{g.rpe}}">RPE {{g.rpe}}</text>
            </view>
            <text class="mark {{g.done ? 'on' : ''}}" data-uid="{{item.uid}}" data-i="{{gi}}" catchtap="tapCardioGroup">{{g.done ? '✓' : '待'}}</text>
          </view>
          <view class="set" wx:if="{{item.cdMode !== 'sets'}}" data-uid="{{item.uid}}" data-cardio="1" bindtap="openEdit">
            <text class="no">1</text>
            <text class="txt {{item.done ? 'done' : ''}}">有氧 · 计时训练 {{item.cdMin}}′</text>
            <text class="mark on">{{item.done ? '✓' : '待'}}</text>
          </view>
          <view class="cfoot">
            <text class="cchg" data-uid="{{item.uid}}" catchtap="openDetail">计组方式 ›</text>
            <view class="focusbtn" data-uid="{{item.uid}}" catchtap="focus">进入专注模式 ›</view>
          </view>
        </view>
      </view>
    </view>

    <view class="empty" wx:if="{{empty}}">
      <text class="et">这个日期还没有训练</text>
      <text class="es">挑一个动作就能开始，不用先排计划</text>
      <view class="cta" bindtap="openAddSheet">＋ 添加动作</view>
      <text class="cta-sub" bindtap="openLibrary" data-part="有氧">或者，先记一条有氧</text>
    </view>

    <!-- 推荐动作：当天动作少时补位 -->
    <view class="card rec" wx:if="{{rec.items.length}}">
      <view class="ch"><text class="ct">推荐 · {{rec.part}}</text><text class="cm">{{rec.recovery}}</text></view>
      <view class="ritem" wx:for="{{rec.items}}" wx:key="exId" data-exid="{{item.exId}}" data-name="{{item.name}}" data-part="{{item.part}}" bindtap="addRec">
        <view class="ri-l">
          <text class="ri-n">{{item.name}}</text>
          <text class="ri-s">{{item.part}} · {{item.line}}</text>
        </view>
        <text class="ri-add">＋ 加入</text>
      </view>
    </view>
</view>

<!-- 计划：日期栏 📅 =「今天练什么」对话（可切到本周排期） -->
<view class="psmask" wx:if="{{planOpen}}" bindtap="closePlan"></view>
<view class="psheet" wx:if="{{planOpen}}">
  <view class="ps-bar"></view>
  <view class="ps-head">
    <text class="ps-t">{{planMode === 'chat' ? '✦ 今天练什么？' : '本周排期'}}</text>
    <view class="ps-h-r">
      <text class="ps-switch" catchtap="switchPlanMode" data-m="{{planMode === 'chat' ? 'week' : 'chat'}}">{{planMode === 'chat' ? '本周排期 ›' : '‹ 今天练什么'}}</text>
      <text class="ps-x" catchtap="closePlan">✕</text>
    </view>
  </view>

  <block wx:if="{{planMode === 'chat'}}">
    <view class="ch-parts">
      <text class="ch-parts-t">部位</text>
      <text class="ch-chip {{item.on ? 'on' : ''}} {{item.warn ? 'warn' : ''}}" wx:for="{{chatParts}}" wx:key="key" data-k="{{item.key}}" catchtap="chatPart">{{item.view}}</text>
    </view>

    <scroll-view class="ch-body" scroll-y="true" enhanced="true" show-scrollbar="false">
      <view class="ch-msgs">
        <view class="ch-m {{item.role}}" wx:for="{{chatMsgs}}" wx:key="index" wx:if="{{index >= chatMsgs.length - 2}}">
          <text class="ch-m-t">{{item.t}}</text>
          <text class="ch-m-s" wx:if="{{item.s}}">{{item.s}}</text>
        </view>
      </view>

      <view class="ch-list" wx:if="{{chatRec && chatRec.items.length}}">
        <block wx:for="{{chatRec.items}}" wx:key="exId">
          <view class="ch-row">
            <view class="ch-l">
              <text class="ch-n">{{item.name}}<text class="ch-cd" wx:if="{{item.cd}}">有氧</text></text>
              <text class="ch-note">{{item.note || item.why}}</text>
            </view>
            <text class="ch-line">{{item.line}}</text>
            <text class="ch-btn" data-i="{{index}}" catchtap="chatEditOpen">改</text>
            <text class="ch-del" data-i="{{index}}" catchtap="chatDel">✕</text>
          </view>
          <!-- 行内 stepper -->
          <view class="ch-edit" wx:if="{{chatEdit === index}}">
            <view class="ch-stp">
              <text class="ch-sk">组</text>
              <text class="ch-sv" data-k="sets" data-d="-1" catchtap="chatStep">−</text>
              <text class="ch-sn">{{chatDraft.sets}}</text>
              <text class="ch-sv" data-k="sets" data-d="1" catchtap="chatStep">＋</text>
            </view>
            <view class="ch-stp">
              <text class="ch-sk">次</text>
              <text class="ch-sv" data-k="reps" data-d="-1" catchtap="chatStep">−</text>
              <text class="ch-sn">{{chatDraft.reps}}</text>
              <text class="ch-sv" data-k="reps" data-d="1" catchtap="chatStep">＋</text>
            </view>
            <view class="ch-stp" wx:if="{{!item.cd}}">
              <text class="ch-sk">kg</text>
              <text class="ch-sv" data-k="weight" data-d="-2.5" catchtap="chatStep">−</text>
              <text class="ch-sn">{{chatDraft.weight}}</text>
              <text class="ch-sv" data-k="weight" data-d="2.5" catchtap="chatStep">＋</text>
            </view>
            <text class="ch-ok" catchtap="chatEditSave">完成</text>
          </view>
        </block>
      </view>
    </scroll-view>

    <view class="ch-acts">
      <text class="ch-again" catchtap="chatReroll">换一批</text>
      <text class="ch-go" catchtap="chatStart">就这样，开练</text>
    </view>
    <view class="ch-in">
      <input class="ch-q" value="{{chatInput}}" bindinput="onChatInput" bindconfirm="chatSend" confirm-type="send"
        placeholder="随便改：改成肩 / 只练两个 / 卧推换上斜" placeholder-class="ch-ph" cursor-spacing="16" disabled="{{chatBusy}}" />
      <text class="ch-send {{chatInput ? 'on' : ''}}" catchtap="chatSend">发送</text>
    </view>
  </block>

  <block wx:else>
    <view class="pw-strip">
      <view class="pw-d {{item.today ? 'today' : ''}} {{item.total ? 'on' : ''}}" wx:for="{{planWeek}}" wx:key="date">
        <text class="pw-w">{{item.w}}</text>
        <text class="pw-md">{{item.md}}</text>
        <view class="pw-dot {{item.total ? 'on' : (item.today ? 'today' : '')}}"></view>
      </view>
    </view>
    <scroll-view class="pw-body" scroll-y="true" enhanced="true" show-scrollbar="false">
      <view class="pw-row {{item.today ? 'today' : ''}}" wx:for="{{planWeek}}" wx:key="date">
        <view class="pw-l">
          <text class="pw-day">周{{item.w}} · {{item.md}}{{item.today ? ' 今天' : ''}}</text>
          <text class="pw-sum" wx:if="{{item.planned || item.total}}">
            {{item.planned ? '排了 ' + item.planned + ' 个动作' : '没排，随手练的'}}{{item.total ? ' · 已完成 ' + item.done + '/' + item.total + ' 组' : ''}}
          </text>
          <text class="pw-sum dim" wx:else>空着</text>
        </view>
        <text class="pw-add" wx:if="{{!item.planned}}" data-date="{{item.date}}" catchtap="planAddDay">＋ 排</text>
      </view>
    </scroll-view>
    <view class="ls-tip">排期只是待办，回＋「从计划加入」才会落成今天的训练</view>
  </block>
</view>

<!-- ＋ 添加 sheet：搜索框（关键词 / 自然语言 / 拍照同一框）+ 三条快速通道 -->
<view class="asmask" wx:if="{{addOpen}}" bindtap="closeAdd"></view>
<view class="asheet" wx:if="{{addOpen}}">
  <view class="ps-bar"></view>
  <view class="ps-head">
    <text class="ps-t">{{addPlanLabel}}</text>
    <text class="ps-x" catchtap="closeAdd">✕</text>
  </view>
  <view class="as-search">
    <text class="as-ic">🔍</text>
    <input class="as-q" value="{{addQuery}}" bindinput="onAddInput" bindconfirm="addSearch" confirm-type="search"
      placeholder="搜动作，或说「只有哑铃练胸」" placeholder-class="as-ph" cursor-spacing="18" />
    <text class="as-act" catchtap="addAiFind">✦</text>
    <text class="as-act" catchtap="addScan">📷</text>
  </view>
  <view class="as-way" catchtap="addPickLib">
    <text class="as-w-ic">🏋</text>
    <view class="as-w-l">
      <text class="as-w-t">从动作库添加</text>
      <text class="as-w-s">5000+ 动作，搜索 / 部位 / 器械筛选</text>
    </view>
    <text class="as-w-go">›</text>
  </view>
  <view class="as-way" catchtap="addCustom">
    <text class="as-w-ic">✎</text>
    <view class="as-w-l">
      <text class="as-w-t">自建动作</text>
      <text class="as-w-s">库里没有的动作，自己建一个</text>
    </view>
    <text class="as-w-go">›</text>
  </view>
  <view class="as-way" wx:if="{{!addPlanDate}}" catchtap="addFromPlan">
    <text class="as-w-ic">📅</text>
    <view class="as-w-l">
      <text class="as-w-t">从计划加入</text>
      <text class="as-w-s">{{planWeekTip}}</text>
    </view>
    <text class="as-w-go">›</text>
  </view>
</view>

<!-- 动作详情浮层：只展示当前这一个动作，不跳动作库 -->
<ex-sheet id="exSheet" visible="{{exSheetVisible}}" ex-id="{{exSheetId}}" ex-name="{{exSheetName}}" uid="{{exSheetUid}}" date="{{date}}" bind:close="closeExSheet" bind:fav="refresh" bind:save="onExSheetSave" bind:edit="onExSheetEdit" />

<!-- 同部位推荐：加完一个动作后弹，可重新推荐 / 继续下一个 -->
<view class="smask" wx:if="{{same.show}}" bindtap="closeSame"></view>
<view class="ssheet" wx:if="{{same.show}}">
  <view class="ss-bar"></view>
  <view class="ss-head">
    <text class="ss-t">✦ 同部位推荐</text>
    <text class="ss-x" catchtap="closeSame">✕</text>
  </view>
  <text class="ss-sub">{{same.part}} · 今天还没练 · 第 {{same.idx + 1}} 个候选</text>
  <view class="ss-card">
    <view class="ss-c-l">
      <text class="ss-n">{{same.name}}</text>
      <text class="ss-meta">{{same.part}} · {{same.equip}} · {{same.line}}</text>
      <text class="ss-why">✦ {{same.why}}</text>
    </view>
    <text class="ss-add" catchtap="addSame">＋ 加入</text>
  </view>
  <view class="ss-btns">
    <view class="ss-btn" catchtap="rerollSame">重新推荐</view>
    <view class="ss-btn ghost" catchtap="nextSame">继续推荐下一个</view>
  </view>
</view>

<train-editor id="editor"
  visible="{{editorVisible}}"
  payload="{{payload}}"
  bind:close="onEditorClose"
  bind:confirm="onEditorConfirm"
  bind:delete="onEditorDelete"
/>

<float-orb id="orb" bottom="{{240}}" dim="{{scrollDim}}" bind:focus="orbFocus" bind:summary="orbSummary" bind:noted="refresh" />
