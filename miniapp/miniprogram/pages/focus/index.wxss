.page { min-height: 100vh; background: #101615; padding: 24rpx 30rpx 60rpx; color: #E8F2EE; box-sizing: border-box; }

.top { display: flex; align-items: center; gap: 18rpx; }
.quit { font-size: 24rpx; color: #9FB0AB; padding: 10rpx 20rpx; border-radius: 24rpx; background: #1A2422; }
.quit.ghost { color: #7F8C88; }
.prog { flex: 1; }
.prog-bar { height: 8rpx; border-radius: 4rpx; background: #202C2A; overflow: hidden; }
.prog-in { height: 8rpx; background: #12A594; }
.prog-t { display: block; margin-top: 8rpx; font-size: 20rpx; color: #7F8C88; text-align: center; }

.queue { white-space: nowrap; margin-top: 18rpx; }
.qbar { display: flex; align-items: center; gap: 10rpx; }
.qbar .queue { flex: 1; width: 0; }
.qmenu { flex: none; height: 56rpx; width: 56rpx; line-height: 56rpx; text-align: center; margin-top: 18rpx; border-radius: 28rpx; background: #1A2422; color: #CFF3EA; font-size: 26rpx; }

.mask { position: fixed; left: 0; top: 0; right: 0; bottom: 0; background: rgba(0,0,0,.55); z-index: 20; }
.listsheet { position: fixed; left: 0; right: 0; bottom: 0; z-index: 21; max-height: 72vh; background: #16211F; border-radius: 28rpx 28rpx 0 0; padding: 18rpx 24rpx 40rpx; }
.ls-h { display: flex; align-items: center; justify-content: space-between; padding: 12rpx 0 18rpx; border-bottom: 1rpx solid #202C2A; }
.ls-body { max-height: 58vh; }
.ls-t { font-size: 24rpx; color: #9FB0AB; }
.ls-x { font-size: 30rpx; color: #7F8C88; padding: 0 10rpx; }
.ls-row { display: flex; align-items: center; gap: 16rpx; padding: 18rpx 12rpx; border-bottom: 1rpx solid #1E2A28; font-size: 26rpx; color: #C7D6D1; flex-wrap: wrap; }
.ls-row.cur { background: rgba(18,165,148,.12); border-radius: 12rpx; }
.ls-row.done { color: #6E8079; }
.ls-i { width: 44rpx; color: #7F8C88; font-size: 22rpx; }
.ls-n { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ls-cd { font-size: 18rpx; color: #E8A93D; }
.ls-st { font-size: 21rpx; color: #8FA09B; }
.ls-ops { width: 100%; display: flex; align-items: center; justify-content: flex-end; gap: 10rpx; margin-top: 10rpx; }
.ls-op {
  font-size: 20rpx; color: #9FB0AB; padding: 8rpx 18rpx; border: 1rpx solid #2A3835; border-radius: 10rpx;
}
.ls-op.del { color: #E06E78; border-color: #4A3036; }
.ls-add { margin-top: 16rpx; text-align: center; font-size: 22rpx; color: #3DDCBF; border: 1rpx dashed #2C403B; border-radius: 12rpx; padding: 16rpx 0; }
.ls-tip { margin-top: 16rpx; text-align: center; font-size: 21rpx; color: #7F8C88; line-height: 1.5; }
.qitem { display: inline-flex; align-items: center; gap: 10rpx; padding: 10rpx 18rpx; margin-right: 12rpx; border-radius: 26rpx; background: #1A2422; font-size: 22rpx; color: #8FA09B; }
.qitem.cur { background: #123D38; color: #CFF3EA; border: 1rpx solid #12A594; }
.qitem.done { color: #3DDCBF; }
.qi-n { width: 30rpx; height: 30rpx; line-height: 30rpx; text-align: center; border-radius: 50%; background: #253230; font-size: 18rpx; }
.qi-t { max-width: 200rpx; overflow: hidden; text-overflow: ellipsis; }
.qitem.cd { border: 1rpx solid rgba(232, 169, 61, .55); }
.qi-cd { font-size: 18rpx; color: #E8A93D; }
.cbadge { padding: 2rpx 10rpx; border-radius: 8rpx; background: rgba(232, 169, 61, .14); color: #E8A93D; font-size: 20rpx; line-height: 28rpx; }

.head { text-align: center; margin-top: 30rpx; }
.name { display: block; font-size: 38rpx; font-weight: 600; }
.part { display: block; margin-top: 8rpx; font-size: 22rpx; color: #7F8C88; }

.stage { position: relative; width: 520rpx; height: 520rpx; margin: 26rpx auto 0; }
.stage.lite { height: 336rpx; }
/* 准备态是短卡：环只用于组间休息，先隐藏，避免在 520×336 里量出非正方形画成椭圆 */
.stage.lite .rings { display: none; }
.stage.lite .dial { width: 300rpx; height: 300rpx; left: 110rpx; top: 6rpx; }
.stage.lite .big { font-size: 64rpx; }
.stage.lite .meta { display: none; }
.rings { position: absolute; left: 0; top: 0; width: 100%; height: 100%; z-index: 2; pointer-events: none; }
.dial { position: absolute; left: 0; top: 0; width: 100%; height: 100%; border-radius: 50%; background: radial-gradient(circle at 50% 40%, #18231F 0%, #101615 72%); border: 3rpx solid #22302D; box-shadow: inset 0 0 0 12rpx rgba(18,165,148,.06); }
.stage.resting .dial { border-color: #3A5E55; box-shadow: inset 0 0 60rpx rgba(61,220,191,.12); }
.stage.paused .dial { animation: ringBreath 2.2s ease-in-out infinite; }
@keyframes ringBreath {
  0% { box-shadow: inset 0 0 0 12rpx rgba(18,165,148,.06); border-color: #22302D; }
  50% { box-shadow: inset 0 0 50rpx rgba(61,220,191,.20); border-color: #3DDCBF; }
  100% { box-shadow: inset 0 0 0 12rpx rgba(18,165,148,.06); border-color: #22302D; }
}
/* 环是可点区域：单击开始/暂停，长按 800ms 完成，双击重置 */
.ring-hit { position: absolute; left: 0; top: 0; width: 100%; height: 100%; border-radius: 50%; z-index: 6; }
/* 暂停态才出现：重置是丢数据，先蓄能 800ms 再执行 */
.reset-lnk {
  position: absolute; left: 0; right: 0; bottom: 132rpx; z-index: 7;
  text-align: center; font-size: 22rpx; color: #7F8C88; text-decoration: underline;
}
.reset-tip {
  position: absolute; left: 0; right: 0; bottom: 132rpx; z-index: 7;
  text-align: center; font-size: 22rpx; color: #3DDCBF;
}
.ctr { position: absolute; left: 0; right: 0; top: 50%; transform: translateY(-58%); text-align: center; }
.ctr.cardio { transform: translateY(-50%); }
.big { display: block; font-size: 92rpx; font-weight: 700; color: #fff; letter-spacing: 2rpx; }
.unit { display: block; margin-top: 8rpx; font-size: 22rpx; color: #7F8C88; white-space: nowrap; }
.meta { position: absolute; left: 0; right: 0; bottom: 76rpx; text-align: center; font-size: 21rpx; color: #A9B7B2; }

.hint { display: block; text-align: center; font-size: 25rpx; color: #9FB0AB; margin-top: 20rpx; }

/* 组间决策行 */
.rest-dec {
  display: flex; align-items: flex-start; gap: 10rpx; margin-top: 16rpx;
  background: rgba(109,140,255,.10); border-left: 4rpx solid #6D8CFF;
  border-radius: 10rpx; padding: 14rpx 16rpx;
}
.rd-star { flex: none; font-size: 22rpx; color: #8FA6FF; }
.rd-t { flex: 1; font-size: 23rpx; line-height: 1.55; color: #CFE0FF; }

.steppers { display: flex; gap: 16rpx; margin-top: 26rpx; }
.stp { flex: 1; display: flex; align-items: center; justify-content: center; gap: 8rpx; background: #172220; border-radius: 16rpx; padding: 14rpx 0; }
.stp-l { flex: none; white-space: nowrap; font-size: 19rpx; color: #7F8C88; }
.sbtn { flex: none; width: 56rpx; height: 56rpx; line-height: 52rpx; text-align: center; border-radius: 50%; background: #22302D; color: #CFF3EA; font-size: 28rpx; }
.snum { min-width: 74rpx; text-align: center; font-size: 27rpx; font-weight: 600; }
.snum.in { background: #0F1715; border-radius: 10rpx; padding: 6rpx 10rpx; color: #E8F2EE; }

.main { margin-top: 30rpx; }
.go { height: 104rpx; line-height: 104rpx; text-align: center; border-radius: 52rpx; font-size: 30rpx; font-weight: 600; }
.primary { background: #12A594; color: #fff; }

.list { margin-top: 32rpx; background: #172220; border-radius: 20rpx; padding: 8rpx 22rpx; }
.row { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 0; border-bottom: 1rpx solid #202C2A; font-size: 24rpx; color: #9FB0AB; }
.row:last-child { border-bottom: none; }
.row.ok { color: #E8F2EE; }
.row.cur { background: rgba(18,165,148,.10); border-radius: 12rpx; }
.no { width: 46rpx; }
.no.warm { color: #D8A23E; }
.detail { flex: 1; }
.sec { font-size: 21rpx; color: #3DDCBF; }
.mark { width: 30rpx; color: #3DDCBF; text-align: right; }
.redo {
  font-size: 19rpx; color: #3DDCBF; padding: 4rpx 12rpx; border: 1rpx solid #2C403B;
  border-radius: 8rpx; background: rgba(61,220,191,.08);
}

.fin { text-align: center; padding-top: 120rpx; }
.fin-t { display: block; font-size: 46rpx; font-weight: 700; color: #fff; }
.fin-s { display: block; margin-top: 18rpx; font-size: 26rpx; color: #9FB0AB; }

/* 动作名 + 详情 */
.nm-row { display: flex; align-items: center; justify-content: center; gap: 12rpx; }
.qmark { width: 40rpx; height: 40rpx; line-height: 38rpx; text-align: center; border-radius: 50%; border: 1rpx solid #3A5E55; color: #3DDCBF; font-size: 22rpx; }

/* 暖身 / RPE */
.marks { display: flex; align-items: center; gap: 16rpx; margin-top: 20rpx; }
.mk-btn { font-size: 21rpx; color: #9FB0AB; background: #172220; border-radius: 12rpx; padding: 10rpx 16rpx; }
.mk-btn.on { color: #D8A23E; border: 1rpx solid #6B532A; background: #221D14; }
.rpe { flex: 1; display: flex; align-items: center; gap: 8rpx; justify-content: flex-end; }
.rpe-l { font-size: 19rpx; color: #7F8C88; }
.rpe-c { width: 44rpx; height: 44rpx; line-height: 42rpx; text-align: center; border-radius: 50%; background: #172220; font-size: 20rpx; color: #8FA09B; }
.rpe-c.on { background: #12A594; color: #fff; }
.rtag { font-size: 17rpx; color: #7F8C88; border: 1rpx solid #2A3835; border-radius: 6rpx; padding: 1rpx 8rpx; }
.rtag.rpe { color: #D8A23E; border-color: #4A3C22; }
.addq { margin-top: 18rpx; text-align: center; font-size: 22rpx; color: #3DDCBF; border: 1rpx dashed #2C403B; border-radius: 12rpx; padding: 16rpx 0; }
.go.hold { letter-spacing: 1rpx; }
.fin-mgr {
  display: flex; align-items: center; justify-content: space-between;
  margin: 26rpx 0 6rpx; padding: 20rpx 24rpx; border-radius: 14rpx;
  background: #172220; border: 1rpx solid #202C2A;
}
.fin-mgr .fm-t { font-size: 24rpx; color: #9FB0AB; }
.fin-mgr .fm-a { font-size: 24rpx; color: #3DDCBF; }
/* 小结 AI 复盘 */
.fin-ai { display: flex; align-items: flex-start; gap: 8rpx; margin-top: 20rpx; background: rgba(61,220,191,0.10); border-left: 4rpx solid #3DDCBF; border-radius: 10rpx; padding: 14rpx 16rpx; }
.fin-ai-sp { font-size: 22rpx; color: #3DDCBF; }
.fin-ai-t { flex: 1; font-size: 24rpx; color: #CFEDE6; line-height: 1.6; }

/* 收工页两个决策卡 */
.fin-dec {
  text-align: left; margin-top: 14rpx;
  background: rgba(109,140,255,.10); border-left: 4rpx solid #6D8CFF;
  border-radius: 10rpx; padding: 14rpx 16rpx;
}
.fd-k { display: block; font-size: 20rpx; color: #8FA6FF; }
.fd-v { display: block; margin-top: 6rpx; font-size: 30rpx; font-weight: 700; color: #EAF0FF; }
.fd-s { display: block; margin-top: 6rpx; font-size: 21rpx; color: #9FB0AB; line-height: 1.5; }
.go.ghost { margin-top: 14rpx; background: transparent; border: 1rpx solid #2C403B; color: #9FB0AB; font-size: 26rpx; height: 88rpx; line-height: 86rpx; }