<view class="wrap">
  <view class="searchbar">
    <input class="search" placeholder="搜索动作名，如 卧推 / 深蹲" bindinput="onInput" value="{{q}}" />
  </view>

  <scroll-view scroll-x class="parts">
    <text
      wx:for="{{parts}}"
      wx:key="*this"
      class="pchip {{part === item ? 'on' : ''}}"
      data-p="{{item}}"
      bindtap="onPart"
    >{{item || '全部'}}</text>
  </scroll-view>

  <view class="count">共 {{total}} 条动作 · 当前筛选 {{list.length}} 条</view>

  <scroll-view scroll-y class="list">
    <view class="item" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="pick">
      <text class="nm">{{item.n}}</text>
      <text class="pt">{{item.p}}</text>
    </view>
    <view class="empty" wx:if="{{!list.length}}">没找到，换个关键词</view>
  </scroll-view>
</view>
