.page { padding: 24rpx 24rpx 200rpx; }
/* 单页流：顶部只留时间窗 + 问 AI */
.head { display: flex; align-items: center; justify-content: space-between; padding: 0 6rpx 12rpx; min-height: 56rpx; }
.head-r { display: flex; align-items: center; gap: 12rpx; }

.ranges { display: flex; gap: 8rpx; }
.rg { font-size: 22rpx; color: #5B6461; background: #fff; border: 1rpx solid #E3E8E6; border-radius: 10rpx; padding: 8rpx 16rpx; }
.rg.on { color: #fff; background: #12A594; border-color: #12A594; }

/* 顶栏 AI 胶囊：三 tab 唯一入口 */
.askcap {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 28rpx;
  background: #EFF9F7;
  font-size: 22rpx;
  color: #12A594;
}
.askcap.off { background: #F2F5F4; color: #98A29E; }

.seg {
  display: inline-flex;
  padding: 4rpx;
  background: #EAEFED;
  border-radius: 14rpx;
  margin-bottom: 20rpx;
}
/* 竖排单页流：卡片向下堆叠，段间 16rpx */
.body { display: flex; flex-direction: column; }
.card { background: #fff; border-radius: 20rpx; padding: 18rpx; margin-bottom: 16rpx; }
.kpiwrap { margin-bottom: 16rpx; }
.tops { margin-top: 6rpx; border-top: 1rpx solid #F1F4F3; }
.sg {
  min-width: 118rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 24rpx;
  color: #5B6461;
  border-radius: 10rpx;
}
.sg.on { background: #fff; color: #14181A; font-weight: 600; }

.ch { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; }
.ct { font-size: 30rpx; font-weight: 600; color: #14181A; }
.cm { font-size: 22rpx; color: #A9B3AF; }

/* ---- 问 AI ---- */
.ai-state { display: flex; align-items: center; gap: 8rpx; }
.dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #C9D4D1; }
.dot.on { background: #12A594; }
.ai-t { font-size: 20rpx; color: #8A9490; }
.ai-line { display: block; margin-bottom: 12rpx; font-size: 23rpx; color: #12A594; }

.askrow { display: flex; align-items: flex-end; gap: 12rpx; }
.qbox {
  flex: 1;
  min-height: 84rpx;
  max-height: 220rpx;
  box-sizing: border-box;
  background: #F6F9F8;
  border-radius: 14rpx;
  padding: 18rpx;
  font-size: 26rpx;
  color: #14181A;
  line-height: 1.45;
}

/* 一键清空草稿：只在有输入时占位 */
.qclear {
  flex: 0 0 44rpx;
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  margin: 0 0 20rpx;
  text-align: center;
  font-size: 22rpx;
  color: #7E8A87;
  background: #EDF2F0;
  border-radius: 50%;
}

.send {
  flex: 0 0 104rpx;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  background: #12A594;
  color: #fff;
  border-radius: 14rpx;
  font-size: 25rpx;
}
.send.off { background: #C9D4D1; }

.sugs { display: flex; flex-wrap: wrap; gap: 10rpx; margin: 14rpx 0 0; }
.sug { font-size: 21rpx; color: #12A594; background: #EFF9F7; border-radius: 8rpx; padding: 8rpx 14rpx; }
.answer { margin-top: 14rpx; background: #F6F9F8; border-radius: 12rpx; padding: 16rpx; }
.atext { font-size: 25rpx; color: #14181A; line-height: 1.65; }

/* 本地规则结论 */
.local { margin-top: 14rpx; background: #10161A; border-radius: 14rpx; padding: 18rpx; }
.local-k { font-size: 20rpx; color: #3DDCBF; letter-spacing: 1rpx; }
.local-t { display: block; margin-top: 10rpx; font-size: 26rpx; font-weight: 600; color: #EAEFF5; }
.local-m { display: block; margin-top: 8rpx; font-size: 24rpx; color: #D6DEE6; line-height: 1.6; }
.local-s { display: block; margin-top: 8rpx; font-size: 20rpx; color: #8A99A5; line-height: 1.5; }

/* ---- 图表卡 ---- */
.chart-card { padding: 18rpx 14rpx 14rpx 18rpx; }
.chart-card .ch { padding-right: 8rpx; }
.lgd { display: flex; gap: 20rpx; padding: 4rpx 0 0 6rpx; }
.lg-i { display: flex; align-items: center; gap: 6rpx; font-size: 22rpx; color: #8A9490; }
.lg-d { width: 14rpx; height: 14rpx; border-radius: 7rpx; }
.lg-d.s1 { background: #12A594; }
.lg-d.s2 { background: #E3B341; }
.lg-d.s3 { background: #E3B341; }
.chart-empty { display: block; font-size: 22rpx; color: #A9B3AF; padding: 18rpx 0 6rpx; }

/* ---- 高亮卡（Apple Health 式：图 + 数字 + 一句话 + 依据） ---- */
.hlc {
  background: #fff;
  border-radius: 18rpx;
  padding: 18rpx 18rpx 14rpx;
  margin-bottom: 14rpx;
  animation: insIn 320ms ease-out both;
}
.hlc-h { display: flex; align-items: baseline; justify-content: space-between; }
.hlc-t { font-size: 30rpx; font-weight: 600; color: #14181A; }
.hlc-num { display: flex; align-items: baseline; gap: 4rpx; }
.hlc-v {
  font-size: 40rpx;
  font-weight: 250;
  color: #14181A;
  font-variant-numeric: tabular-nums;
  letter-spacing: -.02em;
}
.hlc-u { font-size: 20rpx; color: #A9B3AF; }
.hlc-chart { position: relative; margin: 10rpx 0 6rpx; }
.hlc-wait {
  position: absolute;
  right: 8rpx;
  top: 6rpx;
  font-size: 20rpx;
  color: #A9B3AF;
  background: rgba(255,255,255,.9);
  border-radius: 8rpx;
  padding: 4rpx 10rpx;
}
.hlc-stat { display: flex; flex-direction: column; gap: 4rpx; }
.hlc-s { font-size: 26rpx; color: #14181A; font-variant-numeric: tabular-nums; }
.hlc-sub { font-size: 22rpx; color: #8A9490; }
.hlc-ai {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  margin-top: 10rpx;
  background: #F3F9F7;
  border-left: 4rpx solid #12A594;
  border-radius: 10rpx;
  padding: 12rpx 14rpx;
}

/* ---- 洞察卡：色条 + 类别徽标 + 主文案 + 置信度 + 可展开依据 ---- */
.feed { display: flex; flex-direction: column; gap: 8rpx; margin-bottom: 16rpx; }
.ins {
  position: relative;
  background: #fff;
  border-radius: 16rpx;
  padding: 14rpx 16rpx 14rpx 18rpx;
  animation: insIn 320ms ease-out both;
}
.ins::before {
  content: '';
  position: absolute;
  left: 0;
  top: 16rpx;
  bottom: 16rpx;
  width: 8rpx;
  border-radius: 0 8rpx 8rpx 0;
  background: #D8DFDC;
}
.ins.train::before { background: #12A594; }
.ins.energy::before { background: #3DDCBF; }
.ins.mood::before { background: #E3B341; }
.ins.part::before { background: #7FC8BE; }
.ins.gap::before { background: #E06E78; }
.ins.note::before { background: #A9B3AF; }
.ins.fill::before { background: #C9D1CE; }
.ins.rest::before { background: #8FA9C8; }

@keyframes insIn {
  from { opacity: 0; transform: translateY(14rpx); }
  to { opacity: 1; transform: none; }
}

.ins-h { display: flex; align-items: center; gap: 10rpx; }
.ins-badge {
  flex: 0 0 auto;
  font-size: 18rpx;
  color: #5B6461;
  background: #F3F6F5;
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
  line-height: 1.5;
}
.ins-tt { flex: 1; font-size: 28rpx; font-weight: 600; color: #14181A; line-height: 1.4; }
.ins-b { display: flex; align-items: baseline; gap: 10rpx; margin-top: 4rpx; }
.ins-v { font-size: 28rpx; font-weight: 300; color: #12A594; font-variant-numeric: tabular-nums; }
.ins.gap .ins-v { color: #E06E78; }
.ins-s { flex: 1; font-size: 22rpx; color: #6E7874; line-height: 1.5; }

.ev-h { display: flex; align-items: center; gap: 8rpx; margin-top: 8rpx; }
.evd { font-size: 18rpx; color: #12A594; letter-spacing: 2rpx; }
.ev-t { font-size: 22rpx; color: #8A9490; }
.ev-a { margin-left: auto; font-size: 22rpx; color: #12A594; }

.ev { margin-top: 10rpx; border-top: 1rpx solid #F1F4F3; padding-top: 10rpx; }
.ev-row { display: flex; align-items: center; gap: 12rpx; padding: 5rpx 0; }
.ev-k { flex: 1; font-size: 22rpx; color: #5B6461; }
.ev-v { font-size: 22rpx; color: #14181A; }
.ev-go { display: block; margin-top: 6rpx; font-size: 22rpx; color: #12A594; }

/* ---- 问 AI 半屏 sheet ---- */
.askmask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(8, 12, 11, .45);
  z-index: 95;
  display: flex;
  align-items: flex-end;
}
.asksheet {
  width: 100%;
  max-height: 72vh;
  box-sizing: border-box;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  animation: sheetUp 260ms ease-out both;
}
@keyframes sheetUp {
  from { transform: translateY(40rpx); opacity: .6; }
  to { transform: none; opacity: 1; }
}
.as-h { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14rpx; }
.as-hl { display: flex; align-items: center; gap: 12rpx; }
.as-t { font-size: 28rpx; font-weight: 600; color: #14181A; }
.as-x { font-size: 26rpx; color: #8A9490; padding: 0 6rpx; }
.as-body { max-height: 46vh; }

.rep-link { display: flex; align-items: center; gap: 12rpx; margin: 8rpx 0 18rpx; padding: 22rpx 24rpx; background: #fff; border-radius: 18rpx; }
.rl-t { font-size: 24rpx; color: #14181A; font-weight: 600; }
.rl-s { flex: 1; font-size: 20rpx; color: #A9B3AF; }
.rl-a { font-size: 24rpx; color: #C3CCC8; }

.emptycard { padding: 26rpx 24rpx; }
.emptycard.flat { padding: 20rpx 0 0; background: transparent; }
.empty-t { display: block; font-size: 26rpx; color: #14181A; }
.empty-s { display: block; margin-top: 8rpx; font-size: 22rpx; color: #8A9490; line-height: 1.5; }
.empty-cta {
  margin-top: 18rpx;
  display: inline-block;
  padding: 0 26rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 14rpx;
  background: #EFF9F7;
  color: #12A594;
  font-size: 24rpx;
}

/* ---- 训练 ---- */
.prow { display: flex; align-items: center; gap: 12rpx; margin-bottom: 12rpx; }
.pname { width: 72rpx; font-size: 24rpx; color: #5B6461; }
.ptrack { flex: 1; height: 14rpx; background: #EEF2F1; border-radius: 8rpx; overflow: hidden; }
.pfill { height: 100%; background: #3DDCBF; border-radius: 8rpx; }
.pfill.cdc { background: #E3B341; }
.pval { width: 96rpx; text-align: right; font-size: 20rpx; color: #8A9490; }

.trow { display: flex; align-items: center; gap: 10rpx; padding: 12rpx 0; border-top: 1rpx solid #F3F6F5; }
.trow:first-child { border-top: 0; }
.tname { flex: 1; font-size: 25rpx; color: #14181A; }
.tpart { font-size: 19rpx; color: #8A9490; background: #F4F7F6; border-radius: 8rpx; padding: 2rpx 8rpx; }
.tval { font-size: 21rpx; color: #5B6461; }

.empty { display: block; font-size: 23rpx; color: #A9B3AF; padding: 6rpx 0; }
.unlock { padding-top: 6rpx; }

/* ---- 作息热力 ---- */
.hrow { display: flex; align-items: center; gap: 8rpx; margin-bottom: 8rpx; }
.head-row { margin-bottom: 10rpx; }
.hlab { flex: 0 0 60rpx; font-size: 20rpx; color: #8A9490; }
.hslot { flex: 1; text-align: center; font-size: 18rpx; color: #A9B3AF; }
.hcell {
  flex: 1;
  height: 44rpx;
  border-radius: 8rpx;
  background: #F1F4F3;
  display: flex;
  align-items: center;
  justify-content: center;
}
.hcell.w1 { background: #D8F0EB; }
.hcell.w2 { background: #7FD8C8; }
.hcell.w3 { background: #12A594; }
.hn { font-size: 17rpx; color: #14181A; }
.hfoot { display: block; margin-top: 10rpx; font-size: 20rpx; color: #A9B3AF; }

.report-entry { margin-bottom: 16rpx; }

/* 进步 tab */
.pg-head { display: flex; align-items: center; justify-content: space-between; padding: 4rpx 4rpx 12rpx; }
.pure { font-size: 20rpx; color: #12A594; background: #EEF7F5; border-radius: 14rpx; padding: 6rpx 14rpx; }
.pure.on { color: #8A9490; background: #F2F5F4; }
.radar { width: 600rpx; height: 600rpx; margin: 0 auto; display: block; }
.curve { width: 600rpx; height: 300rpx; display: block; margin: 0 auto; }
.eline { width: 100%; height: 140px; display: block; }
.skeleton { height: 132rpx; display: flex; flex-direction: column; justify-content: center; padding-left: 6rpx; }
.sk-t { font-size: 24rpx; color: #8A9490; }
.sk-s { font-size: 22rpx; color: #A9B3AF; margin-top: 4rpx; }
/* 空态骨架条：只占一行，不再用整卡高度装一个空图 */
.skrow { display: flex; align-items: center; gap: 10rpx; padding: 18rpx 4rpx 6rpx; }
.skrow-t { font-size: 22rpx; color: #7C8783; font-weight: 600; }
.skrow-s { font-size: 21rpx; color: #A9B3AF; flex: 1; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.skrow-a { font-size: 21rpx; color: #12A594; }
.ai-line { display: flex; align-items: flex-start; gap: 8rpx; margin-top: 12rpx; background: #F3F9F7; border-left: 4rpx solid #12A594; border-radius: 10rpx; padding: 12rpx 14rpx; }
.ai-line.rule { background: #F7F9F8; border-left-color: #C9D8D4; }
.ai-sp { font-size: 24rpx; color: #12A594; flex-shrink: 0; }
.ai-tx { flex: 1; font-size: 26rpx; color: #4B5551; line-height: 1.6; }
.chips { white-space: nowrap; margin-bottom: 8rpx; }
.chip { display: inline-block; font-size: 22rpx; color: #5B6461; background: #F3F6F5; border-radius: 16rpx; padding: 8rpx 18rpx; margin-right: 12rpx; }
.chip.on { background: #12A594; color: #fff; }
.cv-meta { display: flex; justify-content: space-between; padding: 0 8rpx; }
.cv-d { font-size: 20rpx; color: #8A9490; }
.rc-row { display: flex; align-items: center; gap: 12rpx; padding: 9rpx 0; }
.rc-l { width: 80rpx; font-size: 23rpx; color: #5B6461; }
.rc-bar { flex: 1; height: 10rpx; background: #F0F4F3; border-radius: 6rpx; overflow: hidden; }
.rc-in { height: 100%; border-radius: 6rpx; }
.rc-in.ready { width: 100%; background: #12A594; }
.rc-in.recovering { width: 55%; background: #E3B341; }
.rc-in.done { width: 22%; background: #E27A6A; }
.rc-in.fresh { width: 100%; background: #DCE5E2; }
.rc-t { width: 190rpx; text-align: right; font-size: 21rpx; color: #8A9490; }
.rc-t.ready { color: #12A594; }
.rc-t.recovering { color: #C08A2A; }
.rc-t.done { color: #C15C4E; }
.prl { display: flex; gap: 14rpx; padding: 10rpx 0; }
.prl-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #12A594; margin-top: 10rpx; flex-shrink: 0; }
.prl-b { flex: 1; border-bottom: 1rpx solid #F4F7F6; padding-bottom: 10rpx; }
.prl-h { display: flex; justify-content: space-between; }
.prl-n { font-size: 24rpx; color: #14181A; }
.prl-date { font-size: 20rpx; color: #A6AFAB; }
.prl-v { font-size: 21rpx; color: #12A594; margin-top: 4rpx; display: block; }
.prl-none { font-size: 22rpx; color: #A6AFAB; padding: 10rpx 0; }

/* 问 AI 多轮 */
.chat { margin-top: 14rpx; }
.msg { margin-bottom: 12rpx; }
.msg.u { display: flex; justify-content: flex-end; }
.msg.u .msg-t { background: #12A594; color: #fff; border-radius: 14rpx 14rpx 4rpx 14rpx; padding: 12rpx 16rpx; font-size: 24rpx; max-width: 78%; line-height: 1.55; }
.msg-a { display: flex; align-items: flex-start; gap: 8rpx; background: #F6F9F8; border-radius: 4rpx 14rpx 14rpx 14rpx; padding: 14rpx; }
.msg-a .msg-t { flex: 1; font-size: 24rpx; color: #14181A; line-height: 1.65; }
.clearchat { display: block; text-align: center; font-size: 20rpx; color: #A6AFAB; padding: 8rpx 0 16rpx; }
.thinking { font-size: 22rpx; color: #8A9490; padding: 10rpx 4rpx; }
/* 平台期处置：三选一，写进下周计划 */
.pl { padding: 12rpx 0; border-bottom: 1rpx solid #F4F7F6; }
.pl:last-child { border-bottom: none; padding-bottom: 0; }
.pl-h { display: flex; align-items: baseline; justify-content: space-between; }
.pl-n { font-size: 26rpx; color: #14181A; font-weight: 600; }
.pl-v { font-size: 22rpx; color: #E0A23C; }
.pl-opts { display: flex; gap: 10rpx; margin-top: 12rpx; }
.pl-o { flex: 1; text-align: center; height: 64rpx; line-height: 64rpx; border-radius: 10rpx; background: #F4F7F6; font-size: 22rpx; color: #5B6461; }
.pl-o.on { background: #EDF7F5; color: #12A594; border: 1rpx solid #12A594; line-height: 62rpx; }
