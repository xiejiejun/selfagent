<view class="page">
  <view class="head">
    <view class="ranges">
      <text class="rg {{range === 7 ? 'on' : ''}}" data-n="7" bindtap="switchRange">7 天</text>
      <text class="rg {{range === 30 ? 'on' : ''}}" data-n="30" bindtap="switchRange">30 天</text>
      <text class="rg {{range === 90 ? 'on' : ''}}" data-n="90" bindtap="switchRange">90 天</text>
    </view>
    <view class="askcap {{cloudReady ? '' : 'off'}}" bindtap="openAsk">
      <view class="dot {{cloudReady ? 'on' : ''}}"></view>
      <text>✦ 问 AI</text>
    </view>
  </view>

  <view class="kpiwrap"><kpi-strip items="{{kpis}}" size="lg" /></view>

  <!-- 卡 A：训练量与规律 -->
  <view class="hlc train" data-k="train" bindtap="toggleIns">
    <view class="hlc-h">
      <text class="hlc-t">训练量与规律</text>
      <view class="hlc-num">
        <text class="hlc-v">{{hiTrain.v}}</text>
        <text class="hlc-u">{{hiTrain.unit}}</text>
      </view>
    </view>
    <view class="hlc-chart">
      <canvas wx:if="{{crossOK && !askOpen}}" id="dual" canvas-id="dual" class="eline"></canvas>
      <view class="skrow" wx:if="{{!crossOK}}" data-go="log" catchtap="goEv">
        <text class="skrow-t">容量与有氧</text>
        <text class="skrow-s">还没有记录</text>
        <text class="skrow-a">去记一次 ›</text>
      </view>
      <view class="lgd" wx:if="{{crossOK}}">
        <view class="lg-i"><view class="lg-d s1"></view><text>容量 {{crossVolSum}} kg</text></view>
        <view class="lg-i"><view class="lg-d s3"></view><text>有氧 {{crossCdSum}}′</text></view>
      </view>
    </view>
    <view class="hlc-stat">
      <text class="hlc-s">{{hiTrain.stat}}</text>
      <text class="hlc-sub">{{hiTrain.sub}}</text>
    </view>
    <view class="hlc-ai" wx:if="{{hiTrain.ai}}"><text class="ai-sp">✦</text><text class="ai-tx">{{hiTrain.ai}}</text></view>
    <view class="ev-h" wx:if="{{hiTrain.ev.length}}">
      <text class="evd">{{hiTrain.conf}}</text>
      <text class="ev-t">依据 {{hiTrain.ev.length}} 条</text>
      <text class="ev-a">{{openIns === 0 ? '收起' : '展开'}}</text>
    </view>
    <view class="ev" wx:if="{{openIns === 0 && hiTrain.ev.length}}">
      <view class="ev-row" wx:for="{{hiTrain.ev}}" wx:for-item="ev" wx:key="t">
        <text class="ev-k">{{ev.t}}</text>
        <text class="ev-v">{{ev.v}}</text>
      </view>
      <text class="ev-go" catchtap="goEv">查看记录页 ›</text>
    </view>
  </view>

  <!-- 卡 B：部位均衡 -->
  <view class="card">
    <view class="ch"><text class="ct">部位均衡</text><text class="cm">容量分布 · 近 {{range}} 天</text></view>
    <canvas wx:if="{{radarOK && !askOpen}}" canvas-id="radar" class="radar"></canvas>
    <view class="skrow" wx:if="{{!radarOK}}" bindtap="goTrain">
      <text class="skrow-t">部位均衡</text>
      <text class="skrow-s">还没有部位容量</text>
      <text class="skrow-a">去训练页 ›</text>
    </view>
    <view class="ai-line" wx:if="{{aiPush}}"><text class="ai-sp">✦</text><text class="ai-tx">{{aiPush}}</text></view>
    <view class="ai-line rule" wx:elif="{{prog.pushPull.text}}"><text class="ai-sp">✦</text><text class="ai-tx">{{prog.pushPull.text}}</text></view>
    <view class="tops" wx:if="{{tops.length}}">
      <block wx:for="{{tops}}" wx:key="name">
        <view class="trow" wx:if="{{index < 3}}">
          <text class="tname">{{item.name}}</text>
          <text class="tpart">{{item.part}}</text>
          <text class="tval">{{item.sets}} 组 / {{item.volume}}kg</text>
        </view>
      </block>
    </view>
  </view>

  <!-- 卡 C：进步曲线 -->
  <view class="card">
    <view class="ch"><text class="ct">进步曲线</text><text class="cm">e1RM 估算</text></view>
    <scroll-view class="chips" scroll-x="true" show-scrollbar="false" wx:if="{{prog.curves.length}}">
      <text class="chip {{curveSel === index ? 'on' : ''}}" wx:for="{{prog.curves}}" wx:key="name" data-i="{{index}}" bindtap="selCurve">{{item.name}}</text>
    </scroll-view>
    <canvas wx:if="{{prog.curves.length && !askOpen}}" canvas-id="curve" class="curve"></canvas>
    <view class="cv-meta" wx:if="{{curve}}">
      <text class="cv-d">{{curve.from}} → {{curve.to}} kg e1RM</text>
      <text class="cv-d">{{curve.n}} 个训练日</text>
    </view>
    <view class="ai-line" wx:if="{{aiTrend}}"><text class="ai-sp">✦</text><text class="ai-tx">{{aiTrend}}</text></view>
    <view class="ai-line rule" wx:elif="{{prog.forecast}}"><text class="ai-sp">✦</text><text class="ai-tx">{{prog.forecast.text}}</text></view>
    <view class="skrow" wx:if="{{!prog.curves.length}}" bindtap="goTrain">
      <text class="skrow-t">进步曲线</text>
      <text class="skrow-s">同一动作练满两次带重量记录才画得出</text>
      <text class="skrow-a">去训练页 ›</text>
    </view>
  </view>

  <!-- 卡 D：有氧构成 -->
  <view class="card" wx:if="{{cdComp.length}}">
    <view class="ch"><text class="ct">有氧构成</text><text class="cm">{{cdTotal}}′ · 按项目</text></view>
    <view class="prow" wx:for="{{cdComp}}" wx:key="name">
      <text class="pname">{{item.name}}</text>
      <view class="ptrack"><view class="pfill cdc" style="width: {{item.pct}}%"></view></view>
      <text class="pval">{{item.min}}′</text>
    </view>
  </view>

  <!-- 卡 E：精力与情绪 -->
  <view class="hlc energy" data-k="energy" bindtap="toggleIns">
    <view class="hlc-h">
      <text class="hlc-t">精力与情绪</text>
      <view class="hlc-num">
        <text class="hlc-v">{{hiEnergy.v}}</text>
        <text class="hlc-u">/5</text>
      </view>
    </view>
    <view class="hlc-chart">
      <canvas wx:if="{{lineOK && !askOpen}}" id="eline" canvas-id="eline" class="eline"></canvas>
      <view class="skrow" wx:if="{{!lineOK}}" bindtap="goLog">
        <text class="skrow-t">精力与情绪</text>
        <text class="skrow-s">{{hasNotes ? '还差几天才成线' : '还没有生活记录'}}</text>
        <text class="skrow-a">去写一条 ›</text>
      </view>
      <view class="lgd" wx:if="{{lineOK}}">
        <view class="lg-i"><view class="lg-d s1"></view><text>精力</text></view>
        <view class="lg-i"><view class="lg-d s2"></view><text>情绪</text></view>
      </view>
    </view>
    <view class="hlc-stat">
      <text class="hlc-s">{{hiEnergy.stat}}</text>
      <text class="hlc-sub">{{hiEnergy.sub}}</text>
    </view>
    <view class="hlc-ai" wx:if="{{hiEnergy.ai}}"><text class="ai-sp">✦</text><text class="ai-tx">{{hiEnergy.ai}}</text></view>
    <view class="ev-h" wx:if="{{hiEnergy.ev.length}}">
      <text class="evd">{{hiEnergy.conf}}</text>
      <text class="ev-t">依据 {{hiEnergy.ev.length}} 条</text>
      <text class="ev-a">{{openIns === 1 ? '收起' : '展开'}}</text>
    </view>
    <view class="ev" wx:if="{{openIns === 1 && hiEnergy.ev.length}}">
      <view class="ev-row" wx:for="{{hiEnergy.ev}}" wx:for-item="ev" wx:key="t">
        <text class="ev-k">{{ev.t}}</text>
        <text class="ev-v">{{ev.v}}</text>
      </view>
      <text class="ev-go" catchtap="goEv">查看记录页 ›</text>
    </view>
  </view>

  <!-- 其余洞察（补短板 / 饮食） -->
  <view class="feed" wx:if="{{more.length}}">
    <block wx:for="{{more}}" wx:key="t">
      <view class="ins {{item.k}} {{openIns === item.i ? 'open' : ''}}" data-i="{{item.i}}" bindtap="toggleIns" style="animation-delay: {{index * 40}}ms">
        <view class="ins-h">
          <text class="ins-badge">{{kl[item.k]}}</text>
          <text class="ins-tt">{{item.t}}</text>
        </view>
        <view class="ins-b">
          <text class="ins-v">{{item.v}}</text>
          <text class="ins-s">{{item.sub}}</text>
        </view>
        <view class="ai-line" wx:if="{{item.ai}}"><text class="ai-sp">✦</text><text class="ai-tx">{{item.ai}}</text></view>
        <view class="ev-h" wx:if="{{item.ev.length}}">
          <text class="evd">{{item.conf}}</text>
          <text class="ev-t">依据 {{item.ev.length}} 条</text>
          <text class="ev-a">{{openIns === item.i ? '收起' : '展开'}}</text>
        </view>
        <view class="ev" wx:if="{{openIns === item.i && item.ev.length}}">
          <view class="ev-row" wx:for="{{item.ev}}" wx:for-item="ev" wx:key="t">
            <text class="ev-k">{{ev.t}}</text>
            <text class="ev-v">{{ev.v}}</text>
          </view>
          <text class="ev-go" catchtap="goEv">查看记录页 ›</text>
        </view>
      </view>
    </block>
  </view>

  <!-- 恢复与 PR -->
  <view class="card">
    <view class="ch"><text class="ct">恢复与 PR</text><text class="cm">上次训练距今 · 近 {{range}} 天</text></view>
    <view class="rc-row" wx:for="{{prog.recovery}}" wx:key="label">
      <text class="rc-l">{{item.label}}</text>
      <view class="rc-bar"><view class="rc-in {{item.state}}"></view></view>
      <text class="rc-t {{item.state}}">{{item.text}}</text>
    </view>
    <view class="ai-line" wx:if="{{aiTomorrow}}"><text class="ai-sp">✦</text><text class="ai-tx">{{aiTomorrow}}</text></view>
    <view class="ai-line rule" wx:else><text class="ai-sp">✦</text><text class="ai-tx">{{prog.tomorrow.text}}</text></view>
    <block wx:for="{{prog.prs}}" wx:key="name">
      <view class="prl" wx:if="{{index < 3}}">
        <view class="prl-dot"></view>
        <view class="prl-b">
          <view class="prl-h">
            <text class="prl-n">{{item.name}}</text>
            <text class="prl-date">{{item.label}}</text>
          </view>
          <text class="prl-v">{{item.weight}}kg×{{item.reps}}{{item.up ? ' · e1RM +' + item.up + '%' : (item.first ? ' · 首次记录' : '')}}</text>
        </view>
      </view>
    </block>
    <view class="prl-none" wx:if="{{!prog.prs.length}}">近 {{range}} 天还没有新 PR，按计划推一组就到</view>
  </view>

  <view class="rep-link" bindtap="goReport">
    <text class="rl-t">完整报告</text>
    <text class="rl-s">画像 · 规划 · 趋势推演</text>
    <text class="rl-a">›</text>
  </view>

  <view class="rep-link" bindtap="goReviewHub">
    <text class="rl-t">回顾与档案</text>
    <text class="rl-s">每日复盘 · 周报 · 月度 · 身体数据</text>
    <text class="rl-a">›</text>
  </view>
</view>

<view class="askmask" wx:if="{{askOpen}}" bindtap="closeAsk">
  <view class="asksheet" catchtap="noop">
    <view class="as-h">
      <view class="as-hl">
        <text class="as-t">问 AI</text>
        <view class="ai-state">
          <view class="dot {{cloudReady ? 'on' : ''}}"></view>
          <text class="ai-t">{{cloudReady ? 'AI 已连接' : 'AI 未连接'}}</text>
        </view>
      </view>
      <text class="as-x" bindtap="closeAsk">✕</text>
    </view>

    <view class="askrow">
      <textarea
        class="qbox"
        placeholder="问训练、恢复或计划，可以连着追问"
        value="{{q}}"
        bindinput="onInput"
        auto-height
        maxlength="300"
        confirm-type="send"
        bindconfirm="ask"
        show-confirm-bar="{{false}}"
      />
      <view class="qclear" wx:if="{{q}}" bindtap="clearQ">✕</view>
      <view class="send {{asking || !q ? 'off' : ''}}" bindtap="ask">{{asking ? '…' : '发送'}}</view>
    </view>

    <scroll-view class="as-body" scroll-y="true">
      <view class="sugs">
        <text class="sug" wx:for="{{suggest}}" wx:key="*this" data-t="{{item}}" bindtap="useSuggest">{{item}}</text>
      </view>
      <view class="local" wx:if="{{local}}">
        <view class="local-h"><text class="local-k">本地结论{{local.range ? ' · ' + local.range : ''}}</text></view>
        <text class="local-t">{{local.title}}</text>
        <text class="local-m">{{local.main}}</text>
        <text class="local-s" wx:if="{{local.sub}}">{{local.sub}}</text>
      </view>
      <view class="chat" wx:if="{{chat.length}}">
        <view class="msg {{item.r}}" wx:for="{{chat}}" wx:key="index">
          <text class="msg-t" wx:if="{{item.r === 'u'}}">{{item.t}}</text>
          <view class="msg-a" wx:else><text class="ai-sp">✦</text><text class="msg-t">{{item.t}}</text></view>
        </view>
        <text class="clearchat" bindtap="clearChat">清空对话</text>
      </view>
      <view class="thinking" wx:if="{{asking}}"><text>✦ 正在思考…</text></view>
    </scroll-view>
  </view>
</view>

<ask-orb wx:if="{{!askOpen}}" id="askorb" bottom="{{190}}" unread="{{askUnread}}" bind:open="openAsk" />
