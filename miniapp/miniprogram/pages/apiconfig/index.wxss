.page { min-height: 100vh; background: #F3F7F5; padding: 26rpx 24rpx 60rpx; box-sizing: border-box; }
.card { background: #fff; border-radius: 20rpx; padding: 22rpx; margin-bottom: 18rpx; }
.ch { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 14rpx; }
.ct { font-size: 27rpx; font-weight: 700; color: #14181A; }
.cm { font-size: 20rpx; color: #8A9490; }
.frow { display: flex; align-items: center; margin: 16rpx 0; }
.fl { width: 150rpx; font-size: 24rpx; color: #5B6461; }
.fi { flex: 1; height: 76rpx; background: #F6F9F8; border-radius: 12rpx; padding: 0 20rpx; font-size: 25rpx; }
.acts { display: flex; gap: 14rpx; margin-top: 18rpx; }
.ab { flex: 1; height: 80rpx; line-height: 80rpx; text-align: center; border-radius: 40rpx; font-size: 25rpx; }
.ab.primary { background: #12A594; color: #fff; }
.ab.ghost { background: #F3F7F5; color: #5B6461; }
.ab.off { opacity: .5; }
.res { display: block; margin-top: 16rpx; font-size: 22rpx; color: #454F4C; line-height: 1.6; }
.note .nt { display: block; font-size: 24rpx; font-weight: 600; color: #14181A; margin-bottom: 10rpx; }
.nl { display: block; font-size: 21rpx; color: #8A9490; line-height: 1.7; margin-top: 6rpx; }

.srow { display: flex; align-items: center; gap: 16rpx; padding: 8rpx 0 4rpx; }
.sl { flex: 1; }
.sl-t { display: block; font-size: 24rpx; color: #14181A; }
.sl-s { display: block; margin-top: 4rpx; font-size: 20rpx; color: #8A9490; }
.prev { display: block; margin-top: 14rpx; font-size: 21rpx; color: #5B6461; background: #F6F9F8; border-radius: 10rpx; padding: 14rpx; line-height: 1.6; white-space: pre-wrap; }
