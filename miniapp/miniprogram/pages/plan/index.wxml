<view class="page">
  <view class="card">
    <view class="ch"><text class="ct">本周节奏</text><text class="cm">{{weekDone}} 组 / 周目标 {{days}} 天</text></view>
    <view class="bars">
      <view class="bw" wx:for="{{week}}" wx:key="label">
        <view class="bar {{item.ok ? 'ok' : ''}}" style="height: {{item.h}}rpx"></view>
        <text class="bl">{{item.label}}</text>
      </view>
    </view>
    <!-- 排期信息只出现一次：已排 / 缺口 / 休息，八个格子不再单独占一屏 -->
    <view class="wstats">
      <text class="ws">已排 <text class="ws-v">{{weekTrained}}</text> 天</text>
      <text class="ws">缺口 <text class="ws-v {{weekGap ? 'warn' : ''}}">{{weekGap}}</text> 天</text>
      <text class="ws">休息 <text class="ws-v">{{weekRest}}</text> 天</text>
    </view>

    <!-- 下周排布收进同一张卡：一条问题 + 两个选项，不再另起一屏 -->
    <decision-card
      wx:if="{{weeklyOpen && weekly}}"
      title="下周怎么排"
      question=""
      reason="{{weekly.basis}}"
      meta="{{weekly.text}}"
      options="{{weeklyOpts}}"
      note=""
      bind:pick="onWeeklyPick"
    />
  </view>

  <!-- 平台期检测：加量 / 换动作 / 减量，三选一 -->
  <view class="card" wx:if="{{plateau.length}}">
    <view class="ch">
      <text class="ct">✦ 平台期检测</text>
      <text class="cm">近 4 周 · e1RM 变化 &lt;2%</text>
    </view>
    <view class="pl" wx:for="{{plateau}}" wx:key="name">
      <view class="pl-h">
        <text class="pl-n">{{item.name}}</text>
        <text class="pl-v">{{item.from}} → {{item.to}}kg · {{item.chg > 0 ? '+' : ''}}{{item.chg}}%</text>
      </view>
      <view class="pl-opts">
        <text class="pl-o {{item.pick === 'load' ? 'on' : ''}}" data-i="{{index}}" data-k="load" bindtap="fixPlateau">下周 +2.5kg</text>
        <text class="pl-o {{item.pick === 'swap' ? 'on' : ''}}" data-i="{{index}}" data-k="swap" bindtap="fixPlateau">换动作</text>
        <text class="pl-o {{item.pick === 'deload' ? 'on' : ''}}" data-i="{{index}}" data-k="deload" bindtap="fixPlateau">减量 20%</text>
      </view>
    </view>
  </view>

  <view class="card" wx:if="{{rec && rec.items.length}}">
    <view class="ch">
      <text class="ct">今日推荐 · {{rec.view}}</text>
      <text class="cm {{rec.recovery.warn ? 'warn' : 'ok'}}">{{rec.recovery.text}}</text>
    </view>
    <view class="rec-item" wx:for="{{rec.items}}" wx:key="exId">
      <view class="ri-l">
        <text class="ri-n">{{item.name}}</text>
        <text class="ri-note">{{item.note}}</text>
      </view>
      <text class="ri-line">{{item.line}}</text>
    </view>
    <text class="ptext" wx:if="{{recReason}}">{{recReason}}</text>
    <view class="acts">
      <view class="btn ghost" bindtap="aiWhy">{{askingWhy ? '解读中…' : 'AI 解读理由'}}</view>
      <view class="btn primary" bindtap="importToday">加入今日训练</view>
    </view>
  </view>

  <view class="card">
    <view class="ch"><text class="ct">目标</text></view>
    <view class="frow">
      <text class="fl">每周训练</text>
      <view class="chips">
        <text class="chip {{days === item ? 'on' : ''}}" wx:for="{{[2,3,4,5,6]}}" wx:key="*this" data-n="{{item}}" bindtap="pickDays">{{item}} 天</text>
      </view>
    </view>
    <view class="frow">
      <text class="fl">每天组数</text>
      <input class="fi" type="number" value="{{setsPerDay}}" bindinput="onSets" />
    </view>
    <view class="frow">
      <text class="fl">提醒时间</text>
      <picker mode="time" value="{{remind}}" bindchange="onRemind">
        <text class="fi right">{{remind}} ›</text>
      </picker>
    </view>
    <view class="btn" bindtap="save">保存计划</view>
  </view>

  <view class="card">
    <view class="ch"><text class="ct">AI 周计划</text><text class="cm">{{asking ? '生成中…' : '按你的记录生成'}}</text></view>
    <text class="ptext" wx:if="{{planText}}">{{planText}}</text>
    <text class="empty" wx:else>还没有计划，点下面按最近 30 天记录生成</text>
    <view class="btn ghost" bindtap="askPlan">生成本周计划</view>
  </view>

  <view class="card">
    <view class="ch"><text class="ct">训练提醒</text><text class="cm">{{sub ? '已开启 · ' + remind : '未开启'}}</text></view>
    <text class="tip">只在「该练而没练」的那天 {{remind}} 提醒一次，连着几天没练会喊你回来；一次性订阅，每次推送后需要再点一次授权。</text>
    <text class="tip" wx:if="{{sub}}">{{subTs || '已开启'}} · 今天练过就不会推</text>
    <view class="btn" wx:if="{{!sub}}" bindtap="subscribe">开启提醒</view>
    <view class="btn ghost" wx:else bindtap="unsubscribe">关闭提醒</view>
  </view>
</view>
