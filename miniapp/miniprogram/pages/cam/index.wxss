page { background: #0B0F0E; height: 100%; }

.cam { position: fixed; left: 0; right: 0; top: 0; bottom: 0; background: #0B0F0E; overflow: hidden; }
.cam-v { width: 100%; height: 100%; position: absolute; left: 0; top: 0; }

.fallback { position: absolute; left: 0; right: 0; top: 40%; display: flex; flex-direction: column; align-items: center; gap: 12rpx; }
.fb-t { font-size: 30rpx; color: #E8EFEC; font-weight: 600; }
.fb-s { font-size: 22rpx; color: #8E9A96; }

/* 顶部：退出 + 一行提示 */
.top { position: fixed; left: 0; right: 0; top: 0; padding: 88rpx 200rpx 0 32rpx; display: flex; align-items: center; }
.x { width: 80rpx; height: 80rpx; line-height: 80rpx; text-align: center; font-size: 34rpx; color: #fff; background: rgba(0,0,0,.32); border-radius: 40rpx; flex-shrink: 0; }
.tip { flex: 1; text-align: center; font-size: 24rpx; color: rgba(255,255,255,.82); }

/* 2:3 取景框：虚线 + 四角括号 */
.frame { position: fixed; left: 50%; top: 50%; margin-left: -300rpx; margin-top: -450rpx; width: 600rpx; height: 900rpx; border: 2rpx dashed rgba(255,255,255,.42); border-radius: 24rpx; }
.c { position: absolute; width: 56rpx; height: 56rpx; border: 0 solid rgba(255,255,255,.9); }
.c.tl { left: -4rpx; top: -4rpx; border-left-width: 6rpx; border-top-width: 6rpx; border-top-left-radius: 18rpx; }
.c.tr { right: -4rpx; top: -4rpx; border-right-width: 6rpx; border-top-width: 6rpx; border-top-right-radius: 18rpx; }
.c.bl { left: -4rpx; bottom: -4rpx; border-left-width: 6rpx; border-bottom-width: 6rpx; border-bottom-left-radius: 18rpx; }
.c.br { right: -4rpx; bottom: -4rpx; border-right-width: 6rpx; border-bottom-width: 6rpx; border-bottom-right-radius: 18rpx; }

/* 底部三件套：相册 / 快门 / 打字 */
.bot { position: fixed; left: 0; right: 0; bottom: 0; padding: 24rpx 56rpx 56rpx; display: flex; align-items: center; justify-content: space-between; }
.ib { width: 88rpx; height: 88rpx; border-radius: 22rpx; background: rgba(255,255,255,.12); display: flex; align-items: center; justify-content: center; }
.ic-img { width: 36rpx; height: 28rpx; border-radius: 6rpx; border: 3rpx solid #fff; position: relative; }
.ic-img::after { content: ''; position: absolute; left: 50%; top: 50%; width: 12rpx; height: 12rpx; margin-left: -6rpx; margin-top: -6rpx; border-radius: 50%; background: #fff; }
.ic-tx { width: 44rpx; height: 44rpx; line-height: 44rpx; text-align: center; font-size: 28rpx; color: #fff; border: 3rpx solid #fff; border-radius: 8rpx; }

.sh { width: 96rpx; height: 96rpx; border-radius: 50%; border: 8rpx solid #fff; display: flex; align-items: center; justify-content: center; }
.sh-in { width: 64rpx; height: 64rpx; border-radius: 50%; background: #fff; }
