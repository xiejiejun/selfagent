.page { padding: 24rpx 24rpx 80rpx; }

/* 拍照区 */
.shot { position: relative; height: 320rpx; border-radius: 20rpx; background: #F4F7F6; overflow: hidden; display: flex; align-items: center; justify-content: center; }
.shot.has { background: #101514; }
.shot-img { width: 100%; height: 100%; }
.reshoot { position: absolute; right: 16rpx; bottom: 16rpx; font-size: 21rpx; color: #fff; background: rgba(0,0,0,.42); border-radius: 10rpx; padding: 8rpx 18rpx; }
.tx-h { display: flex; align-items: center; justify-content: space-between; }
.tx-cam { font-size: 22rpx; color: #12A594; }
.shot-empty { display: flex; flex-direction: column; align-items: center; gap: 10rpx; }
.se-t { font-size: 28rpx; font-weight: 600; color: #14181A; }
.se-s { font-size: 22rpx; color: #8A9490; }
.shot-busy { display: flex; flex-direction: column; align-items: center; gap: 16rpx; }
.skel { width: 120rpx; height: 120rpx; border-radius: 24rpx; background: linear-gradient(100deg, #E6EDEB 20%, #F3F7F6 40%, #E6EDEB 60%); background-size: 300% 100%; animation: sk 1.2s linear infinite; }
@keyframes sk { 0% { background-position: 100% 0; } 100% { background-position: -100% 0; } }
.sb-t { font-size: 22rpx; color: #5B6461; }

.shot-btns { display: flex; gap: 12rpx; margin-top: 16rpx; }
.sbtn { flex: 1; height: 84rpx; line-height: 84rpx; text-align: center; font-size: 26rpx; font-weight: 600; color: #fff; background: #12A594; border-radius: 14rpx; }
.sbtn.ghost { color: #12A594; background: #EFF9F7; }

/* 文字兜底 */
.txcard { background: #fff; border-radius: 18rpx; padding: 22rpx; }
.tx-t { font-size: 24rpx; font-weight: 600; color: #14181A; }
.txa { width: 100%; min-height: 140rpx; margin-top: 12rpx; font-size: 26rpx; line-height: 1.6; color: #14181A; }
.tx-btns { display: flex; gap: 12rpx; margin-top: 12rpx; }
.tx-tip { display: block; margin-top: 12rpx; font-size: 20rpx; color: #A9B3AF; }

/* 失败兜底 */
.fail { margin-top: 18rpx; background: #FFF7E6; border: 1rpx solid #F4E1B7; border-radius: 16rpx; padding: 20rpx; }
.fail-t { display: block; font-size: 24rpx; color: #8A5B00; font-weight: 600; }
.fail-s { display: block; margin-top: 6rpx; font-size: 20rpx; color: #9C7419; line-height: 1.5; }
.fail-btns { display: flex; gap: 12rpx; margin-top: 14rpx; }
.fbtn { font-size: 22rpx; color: #8A5B00; border: 1rpx solid #E2C98E; border-radius: 10rpx; padding: 8rpx 20rpx; }

/* 确认卡 */
.card { margin-top: 18rpx; background: #fff; border-radius: 20rpx; padding: 22rpx; }
.chead { display: flex; align-items: flex-start; }
.cl { flex: 1; }
.ct { display: block; font-size: 22rpx; color: #12A594; font-weight: 600; }
.csum { display: flex; align-items: baseline; gap: 8rpx; margin-top: 6rpx; }
.cm { font-size: 24rpx; color: #5B6461; }
.cdot { font-size: 20rpx; color: #A9B3AF; }
.ck { font-size: 46rpx; font-weight: 700; color: #14181A; }
.cu { font-size: 22rpx; color: #A9B3AF; }
.cthumb { width: 96rpx; height: 96rpx; border-radius: 14rpx; background: #EDF1F0; margin-left: 12rpx; }

.mealrow { display: flex; align-items: center; gap: 10rpx; margin-top: 14rpx; }
.mr-l { font-size: 21rpx; color: #8A9490; margin-right: 4rpx; }
.mchip { font-size: 22rpx; color: #5B6461; background: #F0F4F3; border-radius: 10rpx; padding: 8rpx 18rpx; }
.mchip.on { background: #12A594; color: #fff; }

.rows { margin-top: 8rpx; }
.row { display: flex; align-items: center; padding: 20rpx 0; border-top: 1rpx solid #F0F4F3; }
.row.low .rn { color: #A87400; }
.rl { flex: 1; display: flex; align-items: baseline; gap: 10rpx; min-width: 0; }
.rn { font-size: 26rpx; font-weight: 600; color: #14181A; }
.rp { font-size: 21rpx; color: #8A9490; }
.rwarn { font-size: 19rpx; color: #A87400; background: #FFF4DC; border-radius: 8rpx; padding: 4rpx 10rpx; }
.rk { font-size: 28rpx; font-weight: 600; color: #14181A; }
.ru { font-size: 19rpx; color: #A9B3AF; margin-left: 4rpx; }
.rx { width: 56rpx; text-align: center; font-size: 24rpx; color: #B9C2BE; }

.chips { display: flex; align-items: center; gap: 10rpx; padding: 0 0 18rpx; flex-wrap: wrap; }
.chip { font-size: 21rpx; color: #5B6461; background: #F0F4F3; border-radius: 10rpx; padding: 8rpx 18rpx; }
.chip.on { background: #EFF9F7; color: #12A594; border: 1rpx solid #12A594; }
.chip-tip { width: 100%; margin-top: 2rpx; font-size: 18rpx; color: #A9B3AF; }

.addrow { padding: 18rpx 0; border-top: 1rpx solid #F0F4F3; }
.addt { font-size: 23rpx; color: #12A594; }
.addbox { display: flex; align-items: center; gap: 12rpx; padding: 16rpx 0; border-top: 1rpx solid #F0F4F3; }
.addin { flex: 1; height: 68rpx; font-size: 24rpx; background: #F4F7F6; border-radius: 10rpx; padding: 0 16rpx; }
.addok { font-size: 23rpx; color: #fff; background: #12A594; border-radius: 10rpx; padding: 14rpx 24rpx; }

.conf { display: flex; align-items: center; gap: 10rpx; margin-top: 16rpx; }
.cdots { font-size: 22rpx; letter-spacing: 2rpx; color: #12A594; }
.ctx { font-size: 20rpx; color: #8A9490; }
.cnote { display: block; margin-top: 6rpx; font-size: 19rpx; color: #A9B3AF; line-height: 1.5; }
.c-corr { display: block; margin-top: 12rpx; font-size: 21rpx; color: #12A594; }

.save { display: block; margin-top: 22rpx; height: 92rpx; line-height: 92rpx; text-align: center; font-size: 28rpx; font-weight: 600; color: #fff; background: #12A594; border-radius: 16rpx; }
.savenote { display: block; margin-top: 10rpx; text-align: center; font-size: 19rpx; color: #A9B3AF; }

/* 完成态 */
.done { margin-top: 120rpx; display: flex; flex-direction: column; align-items: center; }
.done-i { width: 96rpx; height: 96rpx; line-height: 96rpx; text-align: center; border-radius: 50%; background: #EFF9F7; color: #12A594; font-size: 44rpx; }
.done-t { margin-top: 20rpx; font-size: 30rpx; font-weight: 700; color: #14181A; }
.done-s { margin-top: 10rpx; font-size: 22rpx; color: #8A9490; }
.done-btns { display: flex; gap: 16rpx; margin-top: 40rpx; }
.dbtn { font-size: 26rpx; color: #12A594; background: #EFF9F7; border-radius: 14rpx; padding: 20rpx 40rpx; }
.dbtn.main { color: #fff; background: #12A594; }

/* 今日已记 */
.hist { margin-top: 48rpx; background: #fff; border-radius: 18rpx; padding: 18rpx 22rpx 10rpx; }
.hist.empty { margin-top: 32rpx; }
.hist-h { display: flex; align-items: baseline; justify-content: space-between; }
.hist-t { font-size: 24rpx; font-weight: 600; color: #14181A; }
.hist-s { font-size: 21rpx; color: #8A9490; }
.hist-r { display: flex; align-items: center; gap: 12rpx; padding: 12rpx 0; border-bottom: 1rpx solid #F4F7F6; }
.hist-m { font-size: 23rpx; color: #5B6461; width: 96rpx; flex: none; }
.hist-k { font-size: 23rpx; font-weight: 600; color: #14181A; flex: 1; }
.hist-tm { font-size: 20rpx; color: #A9B3AF; }
