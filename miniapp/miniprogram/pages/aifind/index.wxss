.page { min-height: 100vh; background: #F3F7F5; padding: 26rpx 24rpx 60rpx; box-sizing: border-box; }
.hd { padding: 0 8rpx 16rpx; }
.t { display: block; font-size: 40rpx; font-weight: 700; color: #14181A; }
.s { display: block; margin-top: 8rpx; font-size: 21rpx; color: #8A9490; }
.bar { display: flex; gap: 12rpx; }
.q { flex: 1; height: 80rpx; background: #fff; border-radius: 40rpx; padding: 0 26rpx; font-size: 25rpx; }
.go { width: 110rpx; height: 80rpx; line-height: 80rpx; text-align: center; border-radius: 40rpx; background: #12A594; color: #fff; font-size: 26rpx; }
.chips { white-space: nowrap; margin: 16rpx 0 10rpx; }
.chip { display: inline-block; padding: 9rpx 18rpx; margin-right: 10rpx; background: #fff; border-radius: 22rpx; color: #5B6461; font-size: 21rpx; }
.meta { font-size: 21rpx; color: #8A9490; padding: 4rpx 6rpx 12rpx; }

.intent {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin: 6rpx 0 8rpx;
  padding: 14rpx 18rpx;
  background: #EDF7F4;
  border-left: 5rpx solid #12A594;
  border-radius: 12rpx;
}
.int-k { font-size: 20rpx; color: #0F8C7E; font-weight: 600; }
.int-v { font-size: 23rpx; color: #14181A; }
.int-v.busy { color: #98A29F; }

.clar { margin: 4rpx 0 10rpx; padding: 16rpx 18rpx; background: #FFF8EC; border-left: 5rpx solid #E8A33D; border-radius: 12rpx; }
.clar-q { display: block; font-size: 20rpx; color: #9A6A1E; }
.clar-opts { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 10rpx; }
.clar-o { padding: 9rpx 20rpx; background: #fff; border: 1rpx solid #EBD6B4; border-radius: 22rpx; font-size: 21rpx; color: #7A5A22; }

.miss { display: flex; align-items: center; justify-content: space-between; margin: 0 0 10rpx; padding: 14rpx 18rpx; background: #FDF0F1; border-left: 5rpx solid #E06E78; border-radius: 12rpx; }
.miss-t { flex: 1; font-size: 20rpx; color: #A34B55; }
.miss-a { font-size: 20rpx; color: #C04450; }

.card { display: flex; align-items: center; background: #fff; border-radius: 18rpx; padding: 18rpx 20rpx; margin-bottom: 10rpx; }
.thumb { width: 96rpx; height: 96rpx; border-radius: 14rpx; background: #EEF2F0; flex: none; margin-right: 16rpx; }
.thumb.ph, .d-media-in.ph { display: flex; align-items: center; justify-content: center; }
.phn { font-size: 34rpx; color: #C9D2CE; }
.row { flex: 1; }
.nm { display: block; font-size: 26rpx; font-weight: 600; color: #14181A; }
.mp { display: block; margin-top: 4rpx; font-size: 20rpx; color: #8A9490; }
.why { display: block; margin-top: 5rpx; font-size: 19rpx; color: #0F8C7E; line-height: 1.4; }
.arr { color: #C9D2CE; font-size: 20rpx; }
.empty { text-align: center; padding: 70rpx 0; }
.et { display: block; font-size: 25rpx; color: #454F4C; }
.es { display: block; margin-top: 10rpx; font-size: 21rpx; color: #A9B3AF; }
.tip { display: block; margin-top: 20rpx; font-size: 19rpx; color: #A9B3AF; line-height: 1.6; }
.mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; background: rgba(8,12,11,.5); z-index: 90; display: flex; align-items: flex-end; }
.sheet { width: 100%; max-height: 76vh; overflow: auto; background: #fff; border-radius: 28rpx 28rpx 0 0; padding: 26rpx 28rpx calc(26rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.sh { display: flex; justify-content: space-between; }
.sht { font-size: 30rpx; font-weight: 700; color: #14181A; }
.shx { font-size: 22rpx; color: #8A9490; }
.tags { display: flex; gap: 10rpx; margin-top: 12rpx; }
.tg { padding: 5rpx 14rpx; border-radius: 18rpx; background: #EEF7F5; color: #0E8677; font-size: 20rpx; }
.steps { margin-top: 14rpx; }
.st { display: flex; gap: 12rpx; padding: 7rpx 0; }
.sn { width: 30rpx; height: 30rpx; line-height: 30rpx; text-align: center; border-radius: 50%; background: #EEF7F5; color: #12A594; font-size: 18rpx; }
.sx { flex: 1; font-size: 23rpx; color: #454F4C; line-height: 1.55; }
.none { font-size: 21rpx; color: #A9B3AF; }
.btn { margin-top: 20rpx; height: 88rpx; line-height: 88rpx; text-align: center; border-radius: 44rpx; background: #12A594; color: #fff; font-size: 26rpx; }

.d-media { position: relative; width: 100%; height: 0; padding-bottom: 100%; margin: 14rpx 0; border-radius: 16rpx; overflow: hidden; background: #EEF2F0; }
.d-media-in { position: absolute; left: 0; top: 0; width: 100%; height: 100%; border-radius: 16rpx; background: #EEF2F0; }
