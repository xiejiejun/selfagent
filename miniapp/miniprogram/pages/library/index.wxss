.page { padding: 20rpx 20rpx 60rpx; }

.subrow { display: flex; gap: 12rpx; margin-bottom: 14rpx; }
.subchip { flex: 1; height: 64rpx; line-height: 64rpx; text-align: center; border-radius: 32rpx; background: #EEF4F2; color: #3F4B47; font-size: 23rpx; }

/* 学习态：场景提示 + 三入口卡 */
.learnhint { display: flex; align-items: center; gap: 12rpx; margin-bottom: 14rpx; padding: 16rpx 20rpx; background: #EAF6F3; border-radius: 16rpx; }
.lh-t { flex: 1; font-size: 23rpx; color: #0F8C7E; line-height: 1.45; }
.lh-x { font-size: 21rpx; color: #0F8C7E; padding: 4rpx 8rpx; flex: none; }
.cards3 { display: flex; gap: 12rpx; margin-bottom: 14rpx; }
.ecard { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6rpx; height: 118rpx; background: #fff; border-radius: 18rpx; box-shadow: 0 4rpx 14rpx rgba(20,24,26,.05); }
.ec-ic { font-size: 30rpx; line-height: 1; color: #12A594; }
.ec-t { font-size: 21rpx; color: #3F4B47; }

.bar { display: flex; align-items: center; gap: 14rpx; }
.qwrap { position: relative; flex: 1; }
.q { width: 100%; box-sizing: border-box; height: 76rpx; background: #fff; border-radius: 38rpx; padding: 0 76rpx 0 28rpx; font-size: 25rpx; }
.cam { position: absolute; right: 6rpx; top: 0; width: 64rpx; height: 76rpx; line-height: 76rpx; text-align: center; font-size: 30rpx; }
.fav { width: 72rpx; height: 72rpx; line-height: 72rpx; text-align: center; border-radius: 50%; background: #fff; color: #C9D2CE; font-size: 32rpx; }
.fav.on { color: #12A594; }

/* 统一检索：状态条 / 条件 / 追问 */
.busy { margin-top: 12rpx; padding: 14rpx 20rpx; background: #EEF8F5; border-radius: 12rpx; }
.busy-t { font-size: 23rpx; color: #0F8C7E; }
.srcbar { display: flex; align-items: center; gap: 10rpx; margin-top: 12rpx; }
.src-t { flex: 1; font-size: 23rpx; color: #5B6461; line-height: 1.4; }
.src-t.ai { color: #0F8C7E; }
.src-t.vision { color: #3F4B47; }
.src-n { font-size: 21rpx; color: #A9B3AF; flex: none; }
.cond { display: flex; flex-wrap: wrap; align-items: center; gap: 10rpx; margin-top: 10rpx; }
.cond-l { font-size: 20rpx; color: #A9B3AF; }
.cond-chip { padding: 6rpx 16rpx; background: #EAF6F3; color: #0F8C7E; border-radius: 20rpx; font-size: 21rpx; }
.condpanel { margin-top: 10rpx; padding: 14rpx 16rpx; background: #fff; border-radius: 14rpx; }
.cp-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10rpx; }
.cp-t { font-size: 22rpx; color: #14181A; font-weight: 600; }
.cp-x { font-size: 21rpx; color: #8A9490; }
.cp-opts { display: flex; flex-wrap: wrap; gap: 10rpx; }
.cp-o { padding: 8rpx 18rpx; background: #F4F7F6; border-radius: 20rpx; font-size: 22rpx; color: #3F4B47; }
.clar { margin-top: 12rpx; padding: 14rpx 16rpx; background: #FFF7E8; border-radius: 14rpx; }
.clar-q { display: block; font-size: 22rpx; color: #7A5A10; margin-bottom: 10rpx; }
.clar-opts { display: flex; flex-wrap: wrap; gap: 10rpx; }
.clar-o { padding: 8rpx 18rpx; background: #fff; border-radius: 20rpx; font-size: 22rpx; color: #C08A12; }
.srcnote { display: block; margin-top: 10rpx; font-size: 22rpx; color: #8A9490; }
.srcnote.err { color: #C0553F; }
.why { display: block; margin-top: 4rpx; font-size: 19rpx; color: #0F8C7E; line-height: 1.35; }
.emptybox { padding: 50rpx 30rpx; text-align: center; }
.eb-t { display: block; font-size: 24rpx; color: #8A9490; margin-bottom: 22rpx; }
.eb-q { margin: 12rpx auto 0; padding: 16rpx 20rpx; max-width: 560rpx; background: #fff; border-radius: 32rpx; font-size: 23rpx; color: #3F4B47; }

.chips { white-space: nowrap; margin: 16rpx 0 6rpx; }
.chips.eq { margin-top: 8rpx; }
.chip { display: inline-block; padding: 10rpx 22rpx; margin-right: 12rpx; background: #fff; color: #5B6461; border-radius: 24rpx; font-size: 23rpx; }
.chip.on { background: #12A594; color: #fff; }
.eqchip { background: #EEF4F2; color: #3F4B47; font-size: 22rpx; padding: 8rpx 20rpx; }
.eqchip.on { background: #14181A; color: #CFF3EA; }

.meta { display: flex; justify-content: space-between; font-size: 21rpx; color: #A9B3AF; padding: 10rpx 6rpx 12rpx; }
.warn { color: #D8A23E; }

.grid { display: flex; flex-wrap: wrap; gap: 14rpx; }
.ex-card { position: relative; width: calc((100% - 14rpx) / 2); background: #fff; border-radius: 18rpx; overflow: hidden; }
.thumb { width: 100%; height: 300rpx; background: #EDF2F0; }
.ph { display: flex; flex-direction: column; align-items: center; justify-content: center; background: linear-gradient(160deg, #F4F8F7, #E6EFEC); }
.phn { font-size: 64rpx; color: #8FA09A; font-weight: 600; }
.phs { margin-top: 8rpx; font-size: 19rpx; color: #A9B3AF; }

.star { position: absolute; top: 10rpx; right: 14rpx; font-size: 30rpx; color: rgba(255,255,255,.85); }
.star.on { color: #FFD34D; }

.cover { padding: 12rpx 16rpx 16rpx; }
.n { display: block; font-size: 25rpx; color: #14181A; line-height: 1.3; max-height: 66rpx; overflow: hidden; }
.p { display: block; margin-top: 4rpx; font-size: 20rpx; color: #A9B3AF; }

.more { margin: 26rpx 0 0; height: 76rpx; line-height: 76rpx; text-align: center; background: #fff; border-radius: 38rpx; font-size: 25rpx; color: #5B6461; }
.empty { display: block; text-align: center; color: #A9B3AF; font-size: 24rpx; padding: 80rpx 0; }

/* 详情弹窗 */
.mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; background: rgba(8,12,11,.5); z-index: 90; display: flex; align-items: flex-end; }
/* 详情弹层：头部+内容一起滚，底部按钮固定在页脚（sticky 在高内容里点不中） */
.sheet { width: 100%; max-height: 78vh; overflow: hidden; background: #fff; border-radius: 28rpx 28rpx 0 0; box-sizing: border-box; display: flex; flex-direction: column; }
.d-top { padding: 26rpx 30rpx 0; }
.sheet-scroll { flex: 1 1 auto; min-height: 0; overflow-y: auto; padding: 0 30rpx; }

.d-head { display: block; }
.d-media { position: relative; width: 100%; height: 0; padding-bottom: 100%; margin-bottom: 16rpx; border-radius: 16rpx; background: #EDF2F0; overflow: hidden; }
.d-media-in { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.d-media-in.ph { display: flex; align-items: center; justify-content: center; }
.d-media-in.poster { pointer-events: none; }
.d-tags { display: flex; flex-wrap: wrap; gap: 10rpx; }
.tag { padding: 6rpx 16rpx; border-radius: 20rpx; background: #EEF4F2; color: #3F4B47; font-size: 21rpx; height: 34rpx; line-height: 34rpx; }
.tag.alias { background: #FFF3D6; color: #96660F; }

.d-row { display: flex; align-items: center; gap: 16rpx; margin-top: 22rpx; }
.d-name { flex: 1; height: 78rpx; background: #F4F7F6; border-radius: 14rpx; padding: 0 22rpx; font-size: 28rpx; font-weight: 600; color: #14181A; }
.d-save { width: 110rpx; height: 78rpx; line-height: 78rpx; text-align: center; border-radius: 14rpx; background: #12A594; color: #fff; font-size: 25rpx; }
.d-reset { display: block; margin-top: 12rpx; font-size: 22rpx; color: #A9B3AF; }

.d-sec { margin-top: 28rpx; font-size: 25rpx; font-weight: 600; color: #14181A; }
.d-steps { margin-top: 14rpx; }
.d-step { display: flex; gap: 14rpx; padding: 10rpx 0; }
.d-idx { width: 34rpx; height: 34rpx; line-height: 34rpx; text-align: center; border-radius: 50%; background: #EEF4F2; color: #12A594; font-size: 19rpx; flex: none; margin-top: 4rpx; }
.d-txt { flex: 1; font-size: 24rpx; color: #454F4C; line-height: 1.55; }
.d-none { display: block; margin-top: 14rpx; font-size: 23rpx; color: #A9B3AF; }
.d-err { display: flex; gap: 12rpx; margin-top: 12rpx; padding: 14rpx 16rpx; background: #FFF7E8; border-radius: 12rpx; }
.d-err-ic { font-size: 24rpx; color: #C08A12; line-height: 1.45; }
.d-err-t { flex: 1; font-size: 23rpx; color: #7A5A10; line-height: 1.45; }
.pad { height: 28rpx; }

.d-btns { flex: 0 0 auto; display: flex; gap: 18rpx; padding: 16rpx 30rpx calc(16rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #EEF1F0; background: #fff; }
.d-btn { flex: 1; height: 92rpx; line-height: 92rpx; text-align: center; border-radius: 46rpx; font-size: 27rpx; }
.d-btn.ghost { background: #F4F7F6; color: #454F4C; }
.d-btn.ghost.on { color: #C08A12; }
.d-btn.primary { background: #12A594; color: #fff; font-weight: 600; flex: 1.35; }
.d-btn.favbtn { flex: 1.35; }

.meta .mylib { margin-left: auto; color: #12A594; font-size: 20rpx; background: #EAF6F3; padding: 6rpx 16rpx; border-radius: 20rpx; }
.ex-card .mine { position: absolute; left: 10rpx; top: 10rpx; z-index: 3; font-size: 18rpx; color: #fff; background: rgba(18,165,148,.9); padding: 3rpx 10rpx; border-radius: 12rpx; }
.meta .prog { margin-left: 12rpx; font-size: 19rpx; color: #7E8A86; }
