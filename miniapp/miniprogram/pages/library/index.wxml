<view class="page">
  <view class="subrow">
    <view class="subchip" bindtap="openAiFind">✦ 用一句话添加</view>
    <view class="subchip" bindtap="openScan">✦ 拍照识别</view>
  </view>
  <view class="bar">
    <input class="q" value="{{q}}" bindinput="onInput" focus="{{autoFocus}}" placeholder="搜索动作，如 卧推 / 深蹲" confirm-type="search" />
    <view class="fav {{favOnly ? 'on' : ''}}" bindtap="toggleFavView">★</view>
  </view>

  <scroll-view class="chips" scroll-x="true" enhanced="true" show-scrollbar="false">
    <text class="chip {{part === item ? 'on' : ''}}" wx:for="{{parts}}" wx:key="*this" data-p="{{item}}" bindtap="onPart">{{item}}</text>
  </scroll-view>
  <scroll-view class="chips eq" scroll-x="true" enhanced="true" show-scrollbar="false">
    <text class="chip eqchip {{equip === item ? 'on' : ''}}" wx:for="{{equips}}" wx:key="*this" data-e="{{item}}" bindtap="onEquip">{{item}}</text>
  </scroll-view>

  <view class="meta">
    <text>共 {{total}} 个动作 · 当前 {{shown}}</text>
    <text wx:if="{{noImg > 0}}" class="warn">{{noImg}} 个无图</text>
    <text wx:if="{{imgTotal > 0}}" class="prog">图 {{imgDone}}/{{imgTotal}}</text>
    <text class="mylib" bindtap="toMylib">＋ 我的动作</text>
  </view>

  <view class="grid">
    <view class="ex-card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="openDetail">
      <image wx:if="{{item.fileID}}" class="thumb" src="{{item.fileID}}" mode="aspectFill" lazy-load="true" data-id="{{item.id}}" binderror="thumbErr" />
      <view wx:else class="thumb ph">
        <text class="phn">{{item.n[0]}}</text>
                <text class="phs">{{item.p}}</text>
      </view>
      <text class="star {{item.fav ? 'on' : ''}}" data-id="{{item.id}}" catchtap="star">{{item.fav ? '★' : '☆'}}</text>
      <text class="mine" wx:if="{{item.mine}}">自定义</text>
      <view class="cover">
        <text class="n">{{item.n}}</text>
        <text class="p">{{item.p}} · {{item.e || '自重'}}</text>
      </view>
    </view>
  </view>

  <view class="more" wx:if="{{hasMore}}" bindtap="more">加载更多</view>
  <text class="empty" wx:if="{{!list.length}}">没有匹配的动作，换个部位或方式试试</text>
</view>

<view class="mask" wx:if="{{detail}}" bindtap="closeDetail">
  <view class="sheet" catchtap="noop">
    <view class="d-top">
      <view class="d-media">
        <video wx:if="{{detail.clipID}}" id="dvideo" class="d-media-in" src="{{detail.clipID}}" poster="{{detail.fileID}}" muted loop autoplay playsinline object-fit="cover" show-center-play-btn="{{false}}" binderror="onClipErr" bindloadedmetadata="onClipReady" />
        <image wx:if="{{detail.fileID && !clipReady}}" class="d-media-in poster" src="{{detail.fileID}}" mode="aspectFill" data-id="{{detail.id}}" binderror="thumbErr" />
        <view wx:if="{{!detail.fileID && !detail.clipID}}" class="d-media-in ph"><text class="phn">{{detail.n[0]}}</text></view>
      </view>
      <view class="d-tags">
        <text class="tag">{{detail.p}}</text>
        <text class="tag">{{detail.e || '自重'}}</text>
        <text class="tag" wx:if="{{detail.t}}">{{detail.t}}</text>
        <text class="tag alias" wx:if="{{detail.alias}}">已改名</text>
        <text class="tag alias" wx:if="{{detail.mine}}">自定义</text>
      </view>

      <view class="d-row">
        <input class="d-name" value="{{nameDraft}}" bindinput="onNameInput" maxlength="20" placeholder="动作名称" />
        <text class="d-save" bindtap="saveName">保存</text>
      </view>
      <text class="d-reset" wx:if="{{detail.alias}}" bindtap="resetName">恢复原名（{{detail.raw}}）</text>
    </view>

    <view class="sheet-scroll">
      <view class="d-sec">动作要领</view>
      <view class="d-steps" wx:if="{{detail.steps.length}}">
        <view class="d-step" wx:for="{{detail.steps}}" wx:key="*this">
          <text class="d-idx">{{index + 1}}</text>
          <text class="d-txt">{{item}}</text>
        </view>
      </view>
      <text class="d-none" wx:else>这个动作还没有要领说明</text>
      <view class="pad"></view>
    </view>

    <view class="d-btns">
      <view class="d-btn ghost {{detail.fav ? 'on' : ''}}" data-id="{{detail.id}}" bindtap="star">{{detail.fav ? '★ 已收藏' : '☆ 收藏'}}</view>
      <view class="d-btn primary" bindtap="pickNow">加入今天训练</view>
    </view>
  </view>
</view>
