.page { padding: 28rpx 24rpx 60rpx; }

.head { padding: 4rpx 6rpx 20rpx; }
.hl { display: block; font-size: 40rpx; font-weight: 600; color: #14181A; }
.hs { display: block; margin-top: 8rpx; font-size: 24rpx; color: #8A9490; }

.stats { display: flex; gap: 10rpx; margin-bottom: 20rpx; }
.s { flex: 1; background: #fff; border-radius: 16rpx; padding: 18rpx 14rpx; }
.sv { display: block; font-size: 36rpx; font-weight: 600; color: #14181A; letter-spacing: -.02em; }
.st { display: block; margin-top: 4rpx; font-size: 20rpx; color: #8A9490; }

.card { background: #fff; border-radius: 20rpx; padding: 22rpx; margin-bottom: 18rpx; }
.ch { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14rpx; }
.ct { font-size: 27rpx; font-weight: 600; color: #14181A; }
.cm { font-size: 21rpx; color: #A9B3AF; }

.bars { display: flex; align-items: flex-end; gap: 14rpx; height: 132rpx; }
.bwrap { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; height: 100%; }
.bar { width: 100%; max-width: 44rpx; background: #E6EBE9; border-radius: 8rpx; }
.bar.on { background: #12A594; }
.bl { margin-top: 8rpx; font-size: 19rpx; color: #A9B3AF; }

.names { display: flex; flex-wrap: wrap; gap: 10rpx; }
.nm { font-size: 23rpx; color: #5B6461; background: #F4F7F6; border-radius: 10rpx; padding: 8rpx 14rpx; }
.empty { display: block; font-size: 23rpx; color: #A9B3AF; padding: 6rpx 0 4rpx; }

.acts { display: flex; gap: 12rpx; margin-top: 8rpx; }
.act {
  flex: 1; height: 88rpx; line-height: 88rpx; text-align: center;
  background: #fff; border-radius: 16rpx; font-size: 27rpx; color: #5B6461;
  border: 1rpx solid #E3E8E6;
}
.act.primary { background: #12A594; border-color: #12A594; color: #fff; }
