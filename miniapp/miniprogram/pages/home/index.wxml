<view class="page">
  <view class="head">
    <text class="hl">{{todayLabel}}</text>
    <text class="hs">{{hasToday ? '今天已练 ' + today.done + '/' + today.total + ' 组' : '今天还没开始'}}</text>
  </view>

  <kpi-strip items="{{kpis}}" />

  <view class="card">
    <view class="ch">
      <text class="ct">近 7 天容量</text>
      <text class="cm">峰值自动归一</text>
    </view>
    <view class="bars">
      <view class="bwrap" wx:for="{{week}}" wx:key="label">
        <view class="bar {{item.today ? 'on' : ''}} {{item.volume ? '' : 'zero'}}" style="height: {{item.h}}rpx"></view>
        <text class="bl">{{item.label}}</text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="ch"><text class="ct">今日动作</text></view>
    <view class="names" wx:if="{{names.length}}">
      <text class="nm" wx:for="{{names}}" wx:key="*this">{{item}}</text>
    </view>
    <view class="empty" wx:else>
      <text class="empty-t">今天还没有安排动作</text>
      <view class="empty-cta" bindtap="openLibrary">从动作库挑一个开始</view>
    </view>
  </view>

  <view class="acts">
    <view class="act primary" bindtap="mainCta">{{canStart ? '开始训练' : '先挑今天的动作'}}</view>
  </view>
</view>

<float-orb bottom="{{190}}" bind:focus="orbFocus" bind:noted="refresh" />

<train-editor
  visible="{{editorVisible}}"
  payload="{{payload}}"
  bind:close="onEditorClose"
  bind:confirm="onEditorConfirm"
  bind:delete="onEditorDelete"
/>
