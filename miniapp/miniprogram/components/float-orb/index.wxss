.orb-area {
  position: fixed;
  left: 0; top: 0;
  width: 100vw; height: 100vh;
  pointer-events: none;   /* 透明区域不挡页面点击 */
  z-index: 90;
}

.orb {
  pointer-events: auto;   /* 球本身可交互 */
  position: relative;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #12A594;
  box-shadow: 0 8rpx 24rpx rgba(18, 165, 148, .34);
  overflow: visible;
}

.orb.is-focus {
  background: #14181A;
  box-shadow: 0 8rpx 24rpx rgba(20, 24, 26, .3);
}

.orb.is-sum {
  background: #C08A12;
  box-shadow: 0 8rpx 24rpx rgba(192, 138, 18, .32);
}

.orb.pressing {
  transform: scale(.94);
}

.orb-ch {
  display: block;
  width: 100%;
  font-size: 34rpx;
  line-height: 1;
  font-weight: 600;
  color: #fff;
  text-align: center;
  letter-spacing: 0;
  white-space: nowrap;
}

.orb-badge {
  position: absolute;
  right: 6rpx;
  bottom: 8rpx;
  min-width: 36rpx;
  padding: 0 8rpx;
  height: 28rpx;
  line-height: 28rpx;
  font-size: 18rpx;
  color: #14181A;
  background: #3DDCBF;
  border-radius: 14rpx;
  text-align: center;
  box-sizing: border-box;
}

.orb-menu {
  position: fixed;
  pointer-events: auto;
  transform: translateY(calc(-100% - 16rpx));
  display: flex;
  gap: 8rpx;
  padding: 8rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(20, 24, 26, .16);
  z-index: 95;
  white-space: nowrap;
}

.mopt {
  padding: 12rpx 22rpx;
  font-size: 24rpx;
  color: #5B6461;
  border-radius: 10rpx;
  background: #F4F7F6;
}

.mopt.on {
  color: #fff;
  background: #12A594;
}

.mask {
  pointer-events: auto;   /* 遮罩需要接收点击 */
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 96;
  background: rgba(20, 24, 26, .42);
  z-index: 96;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 12rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  transition: transform .18s ease-out;
}

.sheet-bar {
  width: 64rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #DDE4E2;
  margin: 4rpx auto 14rpx;
}

.sh-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.sh-t { font-size: 30rpx; font-weight: 600; color: #14181A; }
.sh-x { font-size: 30rpx; color: #8A9490; padding: 0 8rpx; }

.ta {
  width: 100%;
  min-height: 140rpx;
  box-sizing: border-box;
  background: #F6F9F8;
  border-radius: 14rpx;
  padding: 18rpx;
  font-size: 26rpx;
  color: #14181A;
  line-height: 1.55;
}

/* 随手记里的拍照记饮食入口 */
.ta-cam {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
  padding: 14rpx 18rpx;
  background: #F6F9F8;
  border: 1rpx solid #E3E8E6;
  border-radius: 14rpx;
}
.tc-i { font-size: 26rpx; }
.tc-t { font-size: 24rpx; color: #14181A; font-weight: 600; }
.tc-s { flex: 1; font-size: 19rpx; color: #98A29F; }
.tc-a { font-size: 24rpx; color: #C2CAC7; }

.sh-btns {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.sh-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 14rpx;
  font-size: 27rpx;
  color: #fff;
  background: #12A594;
}

.sh-btn.ghost {
  background: #fff;
  color: #5B6461;
  border: 1rpx solid #E3E8E6;
}

.score-row { display: flex; align-items: center; margin-top: 18rpx; }
.score-l { width: 72rpx; font-size: 24rpx; color: #5B6461; }
.dots { flex: 1; display: flex; gap: 14rpx; }
.dot { width: 56rpx; height: 56rpx; line-height: 56rpx; text-align: center; border-radius: 50%; background: #F0F4F3; color: #8A9490; font-size: 22rpx; }
.dot.on { background: #12A594; color: #fff; }

/* 滑条 + 档位文案 */
.score-row { display: block; margin-top: 18rpx; }
.score-top { display: flex; align-items: center; justify-content: space-between; }
/* 当前值：大字 + 档位词 */
.score-vw { display: flex; align-items: baseline; gap: 6rpx; }
.score-num { font-size: 38rpx; line-height: 1; font-weight: 700; color: #CBD4D1; }
.score-num.on { color: #0F8C7E; }
.score-num.m.on { color: #6D5FA8; }
.score-u { font-size: 18rpx; color: #B6BEBB; }
.score-w { font-size: 23rpx; color: #98A29F; margin-left: 6rpx; }
.score-w.on { color: #0F8C7E; font-weight: 600; }
.score-w.m.on { color: #6D5FA8; font-weight: 600; }
.score-s { margin: 0; padding: 0 4rpx; }
/* 五档：整块可点，选中实心 */
.score-lab { display: flex; gap: 8rpx; margin-top: 12rpx; }
.sl-i {
  flex: 1;
  height: 58rpx;
  line-height: 58rpx;
  text-align: center;
  font-size: 22rpx;
  color: #8A9490;
  background: #FFF;
  border: 1rpx solid #E3EAE8;
  border-radius: 10rpx;
  transition: color .15s, background .15s;
}
.sl-i.on { color: #fff; background: #12A594; border-color: #12A594; font-weight: 600; }
.sl-i.m.on { color: #fff; background: #8E7CC3; border-color: #8E7CC3; }

/* 保存前识别预览 */
.prev {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 10rpx;
  padding: 12rpx 16rpx;
  background: #F2F8F6;
  border-radius: 12rpx;
}
.prev-k { font-size: 19rpx; color: #0F8C7E; }
.prev-v { font-size: 22rpx; color: #14181A; font-weight: 600; }