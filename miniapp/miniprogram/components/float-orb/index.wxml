<view class="orb-menu" wx:if="{{menuOn}}" style="left: {{menuLeft}}px; top: {{top}}px;">
  <view class="mopt {{mode === 'record' ? 'on' : ''}}" catchtap="pickRecord">随手记</view>
  <view class="mopt {{mode === 'focus' ? 'on' : ''}}" catchtap="pickFocus">专注</view>
  <view class="mopt" catchtap="openLibrary">📚 找动作</view>
</view>

<movable-area class="orb-area">
  <movable-view
    class="orb {{mode === 'focus' ? 'is-focus' : ''}} {{mode === 'summary' ? 'is-sum' : ''}} {{dim ? 'is-dim' : ''}} {{pressing ? 'pressing' : ''}}"
    style="width: {{sizeRpx}}rpx; height: {{sizeRpx}}rpx;"
    direction="all"
    out-of-bounds="false"
    damping="60"
    x="{{mvX}}" y="{{mvY}}"
    bindchange="onMvChange"
    bindtap="onTap"
    bindlongpress="onLong"
  >
    <text class="orb-ch">{{mode === 'focus' ? '练' : (mode === 'summary' ? '结' : '记')}}</text>
    <text class="orb-badge" wx:if="{{mode === 'focus' && countText}}">{{countText}}</text>
  </movable-view>
</movable-area>

<view class="mask" wx:if="{{noteOn}}" catchtap="closeNote">
  <view class="sheet" catchtap="noop" bindtouchstart="onSheetStart" bindtouchmove="onSheetMove" bindtouchend="onSheetEnd" style="transform: translateY({{sheetDy}}px);">
    <view class="sheet-bar"></view>
    <view class="sh-head">
      <text class="sh-t">随手记</text>
      <text class="sh-x" catchtap="closeNote">✕</text>
    </view>
    <textarea
      class="ta"
      value="{{noteText}}"
      bindinput="onNoteInput"
      placeholder="跑了5公里 / 卧推 60 5×5 / 加班到十点，很焦虑"
      auto-height
      maxlength="500"
      show-confirm-bar="{{false}}"
      focus="{{noteOn}}"
    />
    <view class="ta-cam" catchtap="goCam">
      <text class="tc-i">📷</text>
      <text class="tc-t">拍照记饮食</text>
      <text class="tc-s">AI 自动估算热量</text>
      <text class="tc-a">›</text>
    </view>
    <view class="prev" wx:if="{{notePrev}}"><text class="prev-k">✦ 将被识别为</text><text class="prev-v">{{notePrev}}</text></view>
    <view class="score-row">
      <view class="score-top">
        <text class="score-l">精力</text>
        <view class="score-vw">
          <text class="score-num {{noteEnergy ? 'on' : ''}}">{{noteEnergy || '—'}}</text>
          <text class="score-u">/5</text>
          <text class="score-w {{noteEnergy ? 'on' : ''}}">{{noteEnergy ? energyLabels[noteEnergy - 1] : '点一档'}}</text>
        </view>
      </view>
      <view class="score-lab">
        <view class="sl-i {{noteEnergy === index + 1 ? 'on' : ''}}" wx:for="{{energyLabels}}" wx:key="*this" data-k="noteEnergy" data-v="{{index + 1}}" bindtap="pickScore">{{noteEnergy === index + 1 ? '✓ ' : ''}}{{item}}</view>
      </view>
    </view>
    <view class="score-row">
      <view class="score-top">
        <text class="score-l">情绪</text>
        <view class="score-vw">
          <text class="score-num m {{noteMood ? 'on' : ''}}">{{noteMood || '—'}}</text>
          <text class="score-u">/5</text>
          <text class="score-w m {{noteMood ? 'on' : ''}}">{{noteMood ? moodLabels[noteMood - 1] : '点一档'}}</text>
        </view>
      </view>
      <view class="score-lab">
        <view class="sl-i m {{noteMood === index + 1 ? 'on' : ''}}" wx:for="{{moodLabels}}" wx:key="*this" data-k="noteMood" data-v="{{index + 1}}" bindtap="pickScore">{{noteMood === index + 1 ? '✓ ' : ''}}{{item}}</view>
      </view>
    </view>
    <view class="sh-btns">
      <view class="sh-btn ghost" catchtap="closeNote">取消</view>
      <view class="sh-btn" catchtap="saveNote">保存</view>
    </view>
  </view>
</view>
