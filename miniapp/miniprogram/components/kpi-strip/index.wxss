.strip {
  display: flex;
  gap: 10rpx;
}

.cell {
  flex: 1;
  min-width: 0;
  background: #fff;
  border-radius: 16rpx;
  padding: 18rpx 16rpx;
  box-sizing: border-box;
}

.v {
  display: block;
  font-size: 40rpx;
  line-height: 1.1;
  font-weight: 600;
  color: #14181A;
  letter-spacing: -.02em;
}
.l {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  line-height: 1.3;
  color: #8A9490;
}
.n {
  display: block;
  margin-top: 6rpx;
  font-size: 19rpx;
  line-height: 1.35;
  color: #12A594;
}
