.mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(8, 12, 11, .5);
  z-index: 120;
  display: flex; align-items: flex-end;
}

.sheet {
  width: 100%;
  max-height: 93vh;
  display: flex;
  flex-direction: column;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 12rpx 30rpx calc(16rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.grab { width: 70rpx; height: 8rpx; border-radius: 8rpx; background: #D8DEDC; margin: 10rpx auto 14rpx; flex: none; }

.d-media.sm { width: 300rpx; height: 300rpx; }
.d-media {
  position: relative;
  width: 560rpx;
  height: 560rpx;
  margin: 0 auto;
  flex: none;
  border-radius: 16rpx;
  overflow: hidden;
  background: #FFFFFF;
}
.d-media-in { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.d-media-in.ph { display: flex; align-items: center; justify-content: center; }
.d-media-in.poster { pointer-events: none; }
.phn { font-size: 72rpx; color: #8FA09A; font-weight: 600; }
.d-x {
  position: absolute; right: 14rpx; top: 12rpx;
  width: 56rpx; height: 56rpx; line-height: 54rpx; text-align: center;
  border-radius: 50%; background: rgba(20, 26, 24, .42);
  color: #fff; font-size: 30rpx;
}

.d-tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 14rpx; flex: none; }
.tag { padding: 6rpx 16rpx; border-radius: 20rpx; background: #EEF4F2; color: #3F4B47; font-size: 21rpx; height: 34rpx; line-height: 34rpx; }
.tag.alias { background: #FFF3D6; color: #96660F; }

.d-title-row { display: flex; align-items: center; gap: 12rpx; margin-top: 12rpx; flex: none; }
.d-title { display: block; margin-top: 0; font-size: 32rpx; font-weight: 600; color: #14181A; }
.cbadge { padding: 2rpx 10rpx; border-radius: 8rpx; background: rgba(232, 169, 61, .1); color: #E8A93D; font-size: 22rpx; line-height: 30rpx; flex: none; }

/* 计组方式 */
.cmode { display: flex; gap: 12rpx; margin-top: 12rpx; }
.cm-opt { flex: 1; height: 68rpx; line-height: 68rpx; text-align: center; border-radius: 12rpx; background: #F4F7F6; color: #5E6C67; font-size: 25rpx; }
.cm-opt.on { background: #FFF3D6; color: #96660F; font-weight: 600; }
.cm-hint { display: block; margin-top: 10rpx; font-size: 21rpx; color: #A9B3AF; }
.cform { margin-top: 10rpx; }
.cf-row { display: flex; align-items: center; gap: 18rpx; padding: 8rpx 0; }
.cf-l { width: 64rpx; font-size: 24rpx; color: #5E6C67; flex: none; }
.cf-hint { font-size: 22rpx; color: #A9B3AF; }
.stepper { display: flex; align-items: center; gap: 10rpx; }
.st-btn { width: 60rpx; height: 60rpx; line-height: 58rpx; text-align: center; border-radius: 12rpx; background: #F4F7F6; color: #14181A; font-size: 30rpx; }
.st-v { min-width: 96rpx; text-align: center; font-size: 28rpx; font-weight: 600; color: #14181A; }
.st-in { width: 96rpx; height: 60rpx; text-align: center; font-size: 28rpx; font-weight: 600; color: #14181A; background: #F4F7F6; border-radius: 12rpx; }
.csave { flex: none; margin-top: 14rpx; height: 80rpx; line-height: 80rpx; text-align: center; border-radius: 40rpx; background: #E8A93D; color: #fff; font-size: 26rpx; font-weight: 600; }

.sheet-scroll { flex: 1; min-height: 0; overflow: auto; margin-top: 4rpx; }
.d-sec { margin-top: 14rpx; font-size: 25rpx; font-weight: 600; color: #14181A; }
.d-steps { margin-top: 10rpx; }
.d-step { display: flex; gap: 14rpx; padding: 8rpx 0; }
.d-idx { width: 34rpx; height: 34rpx; line-height: 34rpx; text-align: center; border-radius: 50%; background: #EEF4F2; color: #12A594; font-size: 19rpx; flex: none; margin-top: 4rpx; }
.d-txt { flex: 1; font-size: 24rpx; color: #454F4C; line-height: 1.55; }
.d-none { display: block; margin-top: 10rpx; font-size: 23rpx; color: #A9B3AF; }

.d-btns { display: flex; gap: 16rpx; margin-top: 14rpx; flex: none; }
.d-btn { flex: 1; height: 88rpx; line-height: 88rpx; text-align: center; border-radius: 44rpx; font-size: 27rpx; }
.d-btn.ghost { background: #F4F7F6; color: #454F4C; }
.d-btn.ghost.on { color: #C08A12; }
.d-btn.primary { background: #12A594; color: #fff; font-weight: 600; }

/* 专注训练页：深色 */
.mask.dark { background: rgba(0, 0, 0, .6); }
.mask.dark .sheet { background: #121A18; }
.mask.dark .grab { background: #2C3A36; }
.mask.dark .d-media.sm { width: 300rpx; height: 300rpx; }
.d-media { background: #FFFFFF; }
.mask.dark .phn { color: #6F7F7A; }
.mask.dark .tag { background: #1E2A27; color: #B9C6C2; }
.mask.dark .tag.alias { background: #2C2617; color: #D9B267; }
.mask.dark .d-title { color: #E8EFEC; }
.mask.dark .cbadge { background: rgba(232, 169, 61, .16); color: #F0BE66; }
.mask.dark .cm-opt { background: #1E2A27; color: #B9C6C2; }
.mask.dark .cm-opt.on { background: #2C2617; color: #E3C06A; }
.mask.dark .cm-hint { color: #6F7F7A; }
.mask.dark .cf-l { color: #AEBDB8; }
.mask.dark .st-btn, .mask.dark .st-in { background: #1E2A27; color: #E8EFEC; }
.mask.dark .st-v { color: #E8EFEC; }
.mask.dark .d-sec { color: #E8EFEC; }
.mask.dark .d-idx { background: #1E2A27; color: #3DDCBF; }
.mask.dark .d-txt { color: #AEBDB8; }
.mask.dark .d-none { color: #6F7F7A; }
.mask.dark .d-btn.ghost { background: #1E2A27; color: #C6D2CE; }
.mask.dark .d-btn.ghost.on { color: #E3C06A; }
.mask.dark .d-btn.primary { background: #12A594; color: #fff; }


