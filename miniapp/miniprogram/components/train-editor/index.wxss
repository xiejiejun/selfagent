.mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, .38);
  z-index: 900;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  background: #fff;
  border-radius: 22rpx 22rpx 0 0;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  max-height: 86vh;
  display: flex;
  flex-direction: column;
}

.grab {
  width: 72rpx; height: 8rpx;
  border-radius: 8rpx;
  background: #D8DEDC;
  margin: 16rpx auto 4rpx;
}

.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 32rpx 8rpx;
}
.title { font-size: 32rpx; font-weight: 600; color: #14181A; }
.x { font-size: 34rpx; color: #8A9490; padding: 4rpx 10rpx; }

.body { padding: 8rpx 32rpx 0; flex: 1; overflow: auto; }

.field { margin-bottom: 18rpx; }
.field.row { display: flex; align-items: center; justify-content: space-between; }
.label { font-size: 24rpx; color: #8A9490; display: block; margin-bottom: 8rpx; }

.input {
  height: 76rpx;
  border: 1rpx solid #E3E8E6;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #14181A;
}

.rows { display: flex; flex-direction: column; gap: 10rpx; margin: 6rpx 0 14rpx; }

.row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 12rpx;
  background: #F7F9F8;
  border-radius: 14rpx;
  min-height: 76rpx;
}

.no { width: 28rpx; text-align: center; font-size: 22rpx; color: #8A9490; flex: none; }

/* 所有小控件统一 56rpx 高、12rpx 圆角，不再大小混排 */
.tag {
  flex: none;
  padding: 0 12rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  color: #8A9490;
  background: #EDF1EF;
  white-space: nowrap;
}
.tag.warm { color: #C58A2E; background: #FBF1DF; }
.tag.drop { color: #3C7BD1; background: #E8F0FC; }
.tag.side { color: #7A5AC8; background: #F0EAFB; }
.tag.super { color: #C4518E; background: #FBEAF3; }

.num {
  height: 56rpx;
  text-align: center;
  background: #fff;
  border-radius: 12rpx;
  border: 1rpx solid #E3E8E6;
  font-size: 26rpx;
  padding: 0;
}
.num.reps { width: 74rpx; flex: none; }
.num.weight { width: 96rpx; flex: none; }
.num.lr { width: 66rpx; flex: none; }
.unit { font-size: 20rpx; color: #8A9490; flex: none; }
.unit.lr { font-size: 20rpx; color: #A7B1AD; }

/* 单侧 / 左右分开记 开关 */
.switches { margin: 4rpx 0 16rpx; background: #F7F9F8; border-radius: 14rpx; padding: 6rpx 16rpx; }
.sw { display: flex; align-items: center; justify-content: space-between; padding: 10rpx 0; }
.sw-txt { display: flex; flex-direction: column; gap: 2rpx; }
.sw-t { font-size: 26rpx; color: #14181A; }
.sw-s { font-size: 20rpx; color: #8A9490; }
.sw-k {
  flex: none; width: 76rpx; height: 44rpx; border-radius: 44rpx;
  background: #DDE3E1; position: relative; transition: background .18s;
}
.sw-k.on { background: #12A594; }
.knob {
  position: absolute; top: 4rpx; left: 4rpx;
  width: 36rpx; height: 36rpx; border-radius: 50%;
  background: #fff; transition: left .18s;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,.14);
}
.sw-k.on .knob { left: 36rpx; }

.chip {
  flex: none;
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #8A9490;
  background: #fff;
  border: 1rpx solid #E3E8E6;
  padding: 0;
}
.chip.on { color: #12A594; border-color: #12A594; background: #F0FAF7; }
.chip.del { color: #B6BEBB; border-color: transparent; background: #EFF2F1; }

.addset {
  display: block;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 24rpx;
  color: #12A594;
  background: #F2F8F6;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.actions {
  display: flex;
  gap: 12rpx;
  padding: 14rpx 32rpx 10rpx;
  border-top: 1rpx solid #EFF2F1;
}

.btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
}
.btn.ghost { background: #F2F5F4; color: #5B6461; }
.btn.primary { background: #12A594; color: #fff; font-weight: 600; }
.btn.danger { background: #FDF1F2; color: #E06E78; }

/* 深色（专注训练页内嵌） */
.sheet.dark { background: #16211F; }
.sheet.dark .grab { background: #2C3A36; }
.sheet.dark .title { color: #E8F2EE; }
.sheet.dark .x { color: #7F8C88; }
.sheet.dark .label { color: #9FB0AB; }
.sheet.dark .input { background: #101615; border-color: #22302D; color: #E8F2EE; }
.sheet.dark .row { background: #172220; }
.sheet.dark .no { color: #7F8C88; }
.sheet.dark .tag { background: #1E2A28; color: #9FB0AB; }
.sheet.dark .tag.warm { color: #D8A23E; background: #2B2318; }
.sheet.dark .tag.drop { color: #7FA6E8; background: #1B2536; }
.sheet.dark .tag.side { color: #A792E8; background: #211C33; }
.sheet.dark .tag.super { color: #E28AB7; background: #2E1B26; }
.sheet.dark .num { background: #101615; border-color: #22302D; color: #E8F2EE; }
.sheet.dark .unit { color: #8FA09B; }
.sheet.dark .chip { background: #101615; border-color: #22302D; color: #9FB0AB; }
.sheet.dark .chip.on { color: #3DDCBF; border-color: #3DDCBF; background: #12201D; }
.sheet.dark .chip.del { background: #1A2321; color: #7F8C88; border-color: transparent; }
.sheet.dark .addset { color: #3DDCBF; background: #12201D; }
.sheet.dark .actions { border-top-color: #202C2A; }
.sheet.dark .btn.ghost { background: #1A2321; color: #9FB0AB; }
.sheet.dark .btn.danger { background: #2A1B1D; color: #E06E78; }
.sheet.dark .btn.primary { background: #12A594; color: #fff; }
.sheet.dark .switches { background: #172220; }
.sheet.dark .sw-t { color: #E8F2EE; }
.sheet.dark .sw-s { color: #8FA09B; }
.sheet.dark .sw-k { background: #2A3835; }
.sheet.dark .sw-k.on { background: #12A594; }
