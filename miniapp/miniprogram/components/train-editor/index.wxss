.mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, .38);
  z-index: 900;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  background: #fff;
  border-radius: 22rpx 22rpx 0 0;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  max-height: 86vh;
  display: flex;
  flex-direction: column;
}

.grab {
  width: 72rpx; height: 8rpx;
  border-radius: 8rpx;
  background: #D8DEDC;
  margin: 16rpx auto 4rpx;
}

.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 32rpx 8rpx;
}
.title { font-size: 32rpx; font-weight: 600; color: #14181A; }
.x { font-size: 34rpx; color: #8A9490; padding: 4rpx 10rpx; }

.body { padding: 8rpx 32rpx 0; flex: 1; overflow: auto; }

.field { margin-bottom: 18rpx; }
.field.row { display: flex; align-items: center; justify-content: space-between; }
.label { font-size: 24rpx; color: #8A9490; display: block; margin-bottom: 8rpx; }

.input {
  height: 76rpx;
  border: 1rpx solid #E3E8E6;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #14181A;
}

.rows { display: flex; flex-direction: column; gap: 12rpx; margin: 4rpx 0 14rpx; }

.row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 14rpx;
  background: #F7F9F8;
  border-radius: 12rpx;
}

.no { width: 32rpx; text-align: center; font-size: 22rpx; color: #8A9490; }
.num { width: 92rpx; height: 60rpx; text-align: center; background: #fff; border-radius: 10rpx; border: 1rpx solid #E3E8E6; font-size: 26rpx; }
.num.wide { width: 108rpx; }
.unit { font-size: 22rpx; color: #8A9490; }

.chip {
  min-width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  border-radius: 10rpx;
  font-size: 22rpx;
  color: #8A9490;
  background: #fff;
  border: 1rpx solid #E3E8E6;
  padding: 0 8rpx;
}
.chip.on { color: #12A594; border-color: #12A594; }
.chip.del { color: #B6BEBB; }

.ghost { display: inline-block; font-size: 26rpx; color: #12A594; padding: 10rpx 4rpx 20rpx; }

.actions {
  display: flex;
  gap: 14rpx;
  padding: 14rpx 32rpx 10rpx;
  border-top: 1rpx solid #EFF2F1;
}

.btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 14rpx;
  font-size: 29rpx;
}
.btn.ghost { background: #F2F5F4; color: #5B6461; }
.btn.primary { background: #12A594; color: #fff; }
.btn.danger { flex: 0 0 150rpx; background: #FDF1F2; color: #E06E78; }
