<view wx:if="{{visible}}" class="mask" catchtap="close" catchtouchmove="noop">
  <view class="sheet {{theme === 'dark' ? 'dark' : ''}}" catchtap="noop">
    <view class="grab"></view>

    <view class="head">
      <text class="title">{{isNew ? '添加动作' : (mode === 'cardio' ? '编辑有氧' : '编辑动作')}}</text>
      <text class="x" catchtap="close">×</text>
    </view>

    <view class="body">
      <view class="field">
        <text class="label">动作名</text>
        <input class="input" value="{{name}}" bindinput="onName" placeholder="动作名称" />
      </view>

      <block wx:if="{{mode === 'cardio'}}">
        <view class="field">
          <text class="label">时长（分钟）</text>
          <input class="input" type="number" value="{{min}}" bindinput="onMin" />
        </view>
        <view class="field row">
          <text class="label">已完成</text>
          <switch checked="{{done}}" color="#12A594" bindchange="onCardioDone" />
        </view>
      </block>

      <block wx:else>
        <view class="switches">
          <view class="sw" bindtap="toggleUni">
            <view class="sw-txt">
              <text class="sw-t">单侧动作</text>
              <text class="sw-s">{{uni ? '重量按每侧记 · 容量左右各算一遍' : '双臂/双腿同时做，按总重量记'}}</text>
            </view>
            <view class="sw-k {{uni ? 'on' : ''}}"><view class="knob"></view></view>
          </view>
          <view class="sw" wx:if="{{uni}}" bindtap="toggleSplit">
            <view class="sw-txt">
              <text class="sw-t">左右分开记</text>
              <text class="sw-s">{{split ? '每组分别填左/右重量' : '左右同重，只填一个数'}}</text>
            </view>
            <view class="sw-k {{split ? 'on' : ''}}"><view class="knob"></view></view>
          </view>
        </view>

        <view class="rows">
          <view class="row {{split ? 'split' : ''}}" wx:for="{{rows}}" wx:key="no">
            <text class="no">{{item.no}}</text>
            <text class="tag {{item.tag}}" wx:if="{{!split}}" data-i="{{index}}" catchtap="cycleTag">{{item.tagLabel || '常规'}}</text>
            <input class="num reps" type="number" value="{{item.reps}}" data-i="{{index}}" bindinput="onReps" />
            <text class="unit">次</text>
            <block wx:if="{{split}}">
              <text class="unit lr">左</text>
              <input class="num lr" type="digit" maxlength="6" value="{{item.lText}}" data-i="{{index}}" data-k="lText" bindinput="onLR" bindblur="onLRBlur" />
              <text class="unit lr">右</text>
              <input class="num lr" type="digit" maxlength="6" value="{{item.rText}}" data-i="{{index}}" data-k="rText" bindinput="onLR" bindblur="onLRBlur" />
              <text class="unit">kg</text>
            </block>
            <block wx:else>
              <input class="num weight" type="digit" maxlength="6" value="{{item.wText}}" data-i="{{index}}" bindinput="onWeight" bindblur="onWeightBlur" />
              <text class="unit">kg{{uni ? '/侧' : ''}}</text>
            </block>
            <text class="chip {{item.done ? 'on' : ''}}" data-i="{{index}}" catchtap="toggleDone">{{item.done ? '✓' : '待'}}</text>
            <text class="chip del" data-i="{{index}}" catchtap="delSet">×</text>
          </view>
        </view>
        <text class="addset" catchtap="addSet">＋ 加一组</text>
      </block>
    </view>

    <view class="actions">
      <text class="btn ghost" catchtap="close">取消</text>
      <text class="btn danger" catchtap="remove" wx:if="{{!isNew}}">删除</text>
      <text class="btn primary" catchtap="save">保存</text>
    </view>
  </view>
</view>
